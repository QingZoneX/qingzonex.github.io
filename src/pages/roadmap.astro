---
import BaseLayout from '../layouts/BaseLayout.astro';
import { QTABLE_GITHUB_URL, QTABLE_UI_GITHUB_URL, withBase } from '../lib/site';
const active = [
  ['Now','Public Alpha release hardening','Full-stack browser E2E, security defaults and exact release-SHA verification.','https://github.com/QingZoneX/QTable/issues/170'],
  ['Now','Large-table performance & realtime','Continue true server paging, incremental realtime, window loading and measurable 10k/100k/1M-row paths.','https://github.com/QingZoneX/QTable/issues/104'],
  ['Now','Self-host operations','Backup/restore/upgrade guidance and deployment hardening for PostgreSQL plus object storage.','https://github.com/QingZoneX/QTable/issues/173'],
  ['Now','UI release quality','Responsive behavior, accessibility, i18n and consistent loading/empty/error/permission states.','https://github.com/QingZoneX/QTableUI/issues/56'],
];
const next = [
  ['Next','Form View / Public Form','Add a safe form view and public submission contract without creating a second data model.','https://github.com/QingZoneX/QTable/issues/148'],
  ['Next','Table-as-API','Turn each table into a stable developer-facing API with scoped tokens and webhooks.','https://github.com/QingZoneX/QTable/issues/116'],
  ['Next','Skill / Connector platform','Allow authorized, audited integrations with GitHub, QNote and external tools.','https://github.com/QingZoneX/QTable/issues/117'],
  ['Next','Self-hosted / BYO AI hardening','Standardize provider capabilities and strengthen local/OpenAI-compatible model paths.','https://github.com/QingZoneX/QTable/issues/120'],
  ['Next','Semantic duplicate detection','Extend Source Inbox duplicate hints into semantic duplicate recognition.','https://github.com/QingZoneX/QTable/issues/119'],
];
---
<BaseLayout title="Roadmap | QingZoneX" description="Current implementation baseline, active release hardening and future roadmap for QTable and QTableUI.">
  <section class="page-hero"><div class="shell"><span class="eyebrow"><i class="eyebrow-dot"></i> Issue-driven roadmap</span><h1>Separate what exists<br/>from what comes next.</h1><p>GitHub Issues is the detailed source of truth. This page intentionally distinguishes the current implemented baseline from release-hardening work and future product capabilities.</p><div class="page-actions"><a class="button primary" href={`${QTABLE_GITHUB_URL}/issues`}>QTable Issues →</a><a class="button secondary" href={`${QTABLE_UI_GITHUB_URL}/issues`}>QTableUI Issues</a></div></div></section>

  <section class="section"><div class="shell"><div class="section-head"><span class="kicker">Implemented baseline</span><h2>Do not confuse these with roadmap placeholders.</h2><p>The current main branches already include the product surfaces below.</p></div><div class="feature-grid">
    <article class="feature-card"><h3>Five table views</h3><p>Grid, Kanban, Gantt, Calendar and Gallery.</p></article>
    <article class="feature-card"><h3>Work centers</h3><p>Home/My Work and a real Projects Center.</p></article>
    <article class="feature-card"><h3>Dashboards</h3><p>Dashboard Center, workbench, aggregation and public sharing.</p></article>
    <article class="feature-card"><h3>Automation</h3><p>Backend engine plus real Automation Center and execution history.</p></article>
    <article class="feature-card"><h3>Collaboration</h3><p>Notifications, record collaboration/activity paths and realtime notification lifecycle.</p></article>
    <article class="feature-card"><h3>Search & recovery</h3><p>Permission-aware global search, ChangeSet foundations and Recycle Bin.</p></article>
    <article class="feature-card"><h3>AI workflows</h3><p>Goal planning, task planning, workload, assignment, Project Steward and safe action plans.</p></article>
    <article class="feature-card"><h3>Source Inbox</h3><p>QNote/Clipper intake with source context and duplicate hints.</p></article>
    <article class="feature-card"><h3>Private attachments</h3><p>Durable S3-compatible object identity and permission-aware access lifecycle.</p></article>
  </div></div></section>

  <section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">Active hardening</span><h2>Work required to make the public Alpha safer and easier to operate.</h2></div><div class="roadmap">{active.map(([phase,title,description,url]) => <article class="roadmap-item"><span class="roadmap-tag active">{phase}</span><div><h3>{title}</h3><p>{description}</p></div><a class="text-link" href={url}>Issue →</a></article>)}</div></div></section>

  <section class="section"><div class="shell"><div class="section-head"><span class="kicker">Next product capabilities</span><h2>Planned, not represented as shipped.</h2></div><div class="roadmap">{next.map(([phase,title,description,url]) => <article class="roadmap-item"><span class="roadmap-tag">{phase}</span><div><h3>{title}</h3><p>{description}</p></div><a class="text-link" href={url}>Issue →</a></article>)}</div></div></section>

  <section class="cta"><div class="shell"><div class="cta-card"><h2>Use the feature matrix before planning an integration.</h2><p>It gives a compact view of what is implemented, what is being hardened for the Alpha, and what remains roadmap work.</p><div class="hero-actions"><a class="button primary" href={withBase('docs/project/feature-matrix/')}>Feature matrix →</a><a class="button secondary" href={withBase('docs/project/release-status/')}>Release status</a></div></div></div></section>
</BaseLayout>
