---
import BaseLayout from '../layouts/BaseLayout.astro';
import TableTour from '../components/TableTour.astro';
import { QTABLE_GITHUB_URL, QTABLE_UI_GITHUB_URL, withBase } from '../lib/site';
---
<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <span class="eyebrow"><i class="eyebrow-dot"></i> Phase 1 open-source preview · QTable + QTableUI</span>
        <h1>Turn goals into <span class="gradient">structured work.</span></h1>
        <p class="hero-copy">QingZoneX is opening an AI-native project and work management foundation built on multidimensional tables: five project views, real work centers, permission-aware collaboration, dashboards, automation, search, recovery, and AI workflows built around Preview → Confirm → Apply.</p>
        <div class="hero-actions">
          <a class="button primary" href={withBase('docs/getting-started/quick-start/')}>Get started <span aria-hidden="true">→</span></a>
          <a class="button secondary" href={QTABLE_GITHUB_URL}>View QTable on GitHub</a>
        </div>
        <div class="hero-meta"><span>Apache-2.0</span><span>Self-hostable</span><span>AI optional</span><span>Permission-aware</span><span>v0.1.0-alpha</span></div>
      </div>

      <div class="product-window" aria-label="QTable product preview">
        <div class="window-bar"><i class="window-dot"></i><i class="window-dot"></i><i class="window-dot"></i><span class="window-title">QTable · Product Launch</span></div>
        <div class="app-shell">
          <aside class="app-sidebar">
            <div class="side-item active"><i class="side-dot"></i> Home</div>
            <div class="side-item"><i class="side-dot"></i> Projects</div>
            <div class="side-item"><i class="side-dot"></i> Dashboards</div>
            <div class="side-item"><i class="side-dot"></i> Automations</div>
            <div class="side-item"><i class="side-dot"></i> AI</div>
          </aside>
          <div class="app-main">
            <div class="app-toolbar"><strong>Open-source launch</strong><span>My Work · 48 tasks</span></div>
            <div class="view-tabs"><span class="active">Grid</span><span>Kanban</span><span>Gantt</span><span>Calendar</span><span>Gallery</span></div>
            <div class="mini-table">
              <div class="mini-row header"><span>Task</span><span>Status</span><span>Owner</span><span>Priority</span></div>
              <div class="mini-row"><span>Release readiness audit</span><span><i class="status-chip">Done</i></span><span><span class="avatar-stack"><i></i><i></i></span></span><span>High</span></div>
              <div class="mini-row"><span>Full-stack E2E</span><span><i class="status-chip blue">Active</i></span><span><span class="avatar-stack"><i></i></span></span><span>High</span></div>
              <div class="mini-row"><span>Self-host runbook</span><span><i class="status-chip amber">Review</i></span><span><span class="avatar-stack"><i></i><i></i></span></span><span>Medium</span></div>
              <div class="mini-row"><span>Community roadmap</span><span><i class="status-chip">Done</i></span><span><span class="avatar-stack"><i></i></span></span><span>Low</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="logo-strip" aria-label="Technology stack"><div class="shell">{['FastAPI','Strawberry GraphQL','PostgreSQL','Redis','S3-compatible','React 19','TypeScript 6','VTable','Apollo Client','VChart'].map((item) => <span class="tech-chip">{item}</span>)}</div></section>

  <section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">What ships in the current baseline</span><h2>More than a table view.</h2><p>The current main branches already expose the work surfaces needed to operate projects end to end. The public Alpha release gate is focused on hardening and full-stack verification rather than filling placeholder navigation.</p></div><div class="feature-grid">
    <article class="feature-card"><div class="feature-icon">⌂</div><h3>Home, My Work & Projects</h3><p>Task Profile semantics and server-backed project/work aggregation provide a real starting point before users enter a specific table.</p></article>
    <article class="feature-card"><div class="feature-icon">⚡</div><h3>Automation Center</h3><p>Real automation rules, validation, enable/disable, test/run and execution-history paths build on QTable’s automation engine.</p></article>
    <article class="feature-card"><div class="feature-icon">◎</div><h3>Dashboards</h3><p>Workspace-backed Dashboard Center, configurable widgets, server aggregation, charts and permission-safe public sharing.</p></article>
    <article class="feature-card"><div class="feature-icon">✉</div><h3>Notifications & records</h3><p>Realtime notification paths, record collaboration surfaces, activity context and deep-link recovery keep work connected.</p></article>
    <article class="feature-card"><div class="feature-icon">⌕</div><h3>Search & recovery</h3><p>Permission-aware global search and a real Recycle Bin complement ChangeSet/audit foundations and safer delete semantics.</p></article>
    <article class="feature-card"><div class="feature-icon">✦</div><h3>AI + Source Inbox</h3><p>Goal-to-workspace generation, planning, workload estimation, assignment, Project Steward, action plans and QNote/Clipper intake.</p></article>
  </div></div></section>

  <section class="section"><div class="shell"><div class="section-head"><span class="kicker">Open-source foundation</span><h2>Two repositories. One coherent product.</h2><p>QTable owns data models, permissions, storage, auditability, APIs, automation and AI services. QTableUI turns those contracts into the interactive application.</p></div><div class="two-col">
    <article class="product-card"><span class="eyebrow">Backend · v0.1.0-alpha</span><h3>QTable</h3><p>FastAPI + GraphQL backend for multidimensional work, permission-aware services and self-hosted infrastructure.</p><ul><li>Five view models, fields, filters, sorting, grouping and named views</li><li>Row-level permissions, global search, automation and ChangeSet foundations</li><li>Crash-safe private S3-compatible attachment lifecycle</li><li>AI planning with safe preview, selective acceptance and apply</li></ul><a class="text-link" href={withBase('qtable/')}>Explore QTable <span>→</span></a></article>
    <article class="product-card ui"><span class="eyebrow">Frontend · v0.1.0-alpha</span><h3>QTableUI</h3><p>React 19 + TypeScript product UI for views, work centers, collaboration, dashboards, automation and AI workflows.</p><ul><li>Home/My Work, Projects, Dashboards and Automations</li><li>Grid, Kanban, Gantt, Calendar and Gallery</li><li>Notifications, Record Workspace, Source Inbox and Recycle Bin</li><li>Docker/Nginx runtime with API, GraphQL, WebSocket and OAuth proxying</li></ul><a class="text-link" href={withBase('qtable-ui/')}>Explore QTableUI <span>→</span></a></article>
  </div></div></section>

  <section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">Product model</span><h2>One table, multiple ways to operate.</h2><p>The same work can move between Grid, Kanban, Gantt, Calendar and Gallery without creating a second task database.</p></div><TableTour /></div></section>

  <section class="section"><div class="shell"><div class="section-head"><span class="kicker">AI workflow</span><h2>AI proposes. You stay in control.</h2><p>AI uses the same Table, View, Dashboard and Permission models as manual work.</p></div><div class="flow"><div class="flow-step"><b>Describe a goal</b><span>Start from intent instead of configuration.</span></div><div class="flow-step"><b>Generate structure</b><span>Create workspace and table plans.</span></div><div class="flow-step"><b>Plan & estimate</b><span>Break down work and estimate workload.</span></div><div class="flow-step"><b>Preview changes</b><span>Inspect diffs and accept selectively.</span></div><div class="flow-step"><b>Revalidate & apply</b><span>Check permission and current state again.</span></div></div></div></section>

  <section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">Architecture</span><h2>Self-hosted core, optional AI.</h2><p>The canonical stack uses PostgreSQL, Redis and private S3-compatible storage. Core table functionality does not require an external AI provider.</p></div><div class="architecture"><div class="arch-box primary"><strong>QTableUI</strong><span>React + TypeScript + VTable + Apollo</span></div><div class="arch-arrow">↓ HTTP / GraphQL / WebSocket ↓</div><div class="arch-box primary"><strong>QTable API</strong><span>FastAPI + Strawberry GraphQL</span></div><div class="arch-arrow">↓</div><div class="arch-row"><div class="arch-box"><strong>PostgreSQL / SQLite</strong><span>recommended / explicit fallback</span></div><div class="arch-box"><strong>Redis</strong><span>runtime services</span></div></div><div class="arch-row"><div class="arch-box"><strong>Permission / ChangeSet / AI</strong><span>application services</span></div><div class="arch-box"><strong>MinIO / S3-compatible</strong><span>private attachments</span></div></div></div></div></section>

  <section class="section"><div class="shell"><div class="section-head"><span class="kicker">Release transparency</span><h2>Implemented baseline, active hardening.</h2><p>The Alpha baseline is usable and tested, while public-release work continues around browser-level full-stack E2E, security defaults, operations runbooks and large-table performance. The portal keeps these separate from future product features.</p></div><div class="two-col"><article class="product-card"><h3>Know what is implemented</h3><p>Use the feature matrix to distinguish current product surfaces from roadmap work.</p><a class="text-link" href={withBase('docs/project/feature-matrix/')}>Feature matrix →</a></article><article class="product-card ui"><h3>Prepare a deployment</h3><p>Use the production checklist before exposing a self-hosted Alpha to real users.</p><a class="text-link" href={withBase('docs/getting-started/production-checklist/')}>Production checklist →</a></article></div></div></section>

  <section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">Ecosystem boundary</span><h2>QingZoneX is the ecosystem. QSpace is a separate product layer.</h2><p>The first open-source phase contains QTable and QTableUI. QSpace is not required to self-host or develop QTable.</p></div></div></section>

  <section class="cta"><div class="shell"><div class="cta-card"><h2>Build with QTable and QTableUI.</h2><p>Start locally, inspect the feature matrix, and follow GitHub Issues for active release gates and roadmap work.</p><div class="hero-actions"><a class="button primary" href={withBase('docs/')}>Read the docs →</a><a class="button secondary" href={QTABLE_GITHUB_URL}>QTable source</a><a class="button ghost" href={QTABLE_UI_GITHUB_URL}>QTableUI source</a></div></div></div></section>
</BaseLayout>
