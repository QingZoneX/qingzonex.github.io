---
import '../styles/global.css';
import '../styles/i18n.css';
import { LOCALE_SETTINGS, SUPPORTED_LOCALES, localeBootstrapScript, localePath } from '../lib/i18n.mjs';
import { withBase } from '../lib/site';
const base = import.meta.env.BASE_URL || '/';
const bootstrap = localeBootstrapScript(base);
const messages = {
  'zh-cn': { title:'页面不存在', copy:'你访问的页面可能已移动、被删除，或地址输入有误。', home:'返回首页', docs:'阅读文档', language:'选择语言' },
  'zh-tw': { title:'找不到頁面', copy:'你造訪的頁面可能已移動、刪除，或網址輸入有誤。', home:'返回首頁', docs:'閱讀文件', language:'選擇語言' },
  en: { title:'Page not found', copy:'The page may have moved, been removed, or the address may be incorrect.', home:'Back home', docs:'Read the docs', language:'Select language' },
};
---
<!doctype html><html lang="zh-CN" data-theme="dark" data-locale="zh-cn"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,follow"/><meta name="color-scheme" content="dark light"/><link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml"/><title>404 · QingZoneX</title><script is:inline set:html={bootstrap}></script><script is:inline>try { const state=window.__QINGZONEX_I18N__; if(state?.current){ const langs={'zh-cn':'zh-CN','zh-tw':'zh-TW',en:'en'}; document.documentElement.dataset.locale=state.current; document.documentElement.lang=langs[state.current]||'zh-CN'; } const stored=localStorage.getItem('starlight-theme'); document.documentElement.dataset.theme=stored||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark'); } catch {}</script><style>.not-found{min-height:100vh;display:grid;place-items:center;padding:40px 0}.not-found-card{max-width:680px;padding:48px;border:1px solid var(--line);border-radius:24px;background:var(--bg-elevated);text-align:center}.not-found-code{color:var(--accent);font:800 13px/1 ui-monospace,monospace}.not-found-card h1{margin:16px 0 10px;font-size:clamp(38px,7vw,64px)}.not-found-card p{color:var(--muted-strong)}[data-locale-panel]{display:none}html[data-locale='zh-cn'] [data-locale-panel='zh-cn'],html[data-locale='zh-tw'] [data-locale-panel='zh-tw'],html[data-locale='en'] [data-locale-panel='en']{display:block}.not-found-tools{margin-top:26px;display:flex;gap:10px;justify-content:center;flex-wrap:wrap}</style></head><body><main class="not-found"><div class="not-found-card"><div class="not-found-code">404 · QingZoneX</div>{SUPPORTED_LOCALES.map((locale)=><section data-locale-panel={locale}><h1>{messages[locale].title}</h1><p>{messages[locale].copy}</p><div class="not-found-tools"><label class="locale-control"><span class="sr-only">{messages[locale].language}</span><select data-locale-select aria-label={messages[locale].language}>{SUPPORTED_LOCALES.map((code)=><option value={localePath(code,'',base)} data-locale={code} selected={code===locale}>{LOCALE_SETTINGS[code].label}</option>)}</select></label><a class="button primary" href={localePath(locale,'',base)}>{messages[locale].home}</a><a class="button secondary" href={localePath(locale,'docs/',base)}>{messages[locale].docs}</a></div></section>)}</div></main></body></html>
