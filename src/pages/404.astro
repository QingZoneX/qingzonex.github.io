---
import '../styles/global.css';
import '../styles/i18n.css';
import LocaleSwitcher from '../components/LocaleSwitcher.astro';
import { SUPPORTED_LOCALES, localeBootstrapScript, localePath } from '../lib/i18n.mjs';
import { withBase } from '../lib/site';
const base = import.meta.env.BASE_URL || '/';
const bootstrap = localeBootstrapScript(base);
const messages = {
  'zh-cn': { title:'页面不存在', copy:'你访问的页面可能已移动、被删除，或地址输入有误。', home:'返回首页', docs:'阅读文档', language:'选择语言' },
  'zh-tw': { title:'找不到頁面', copy:'你造訪的頁面可能已移動、刪除，或網址輸入有誤。', home:'返回首頁', docs:'閱讀文件', language:'選擇語言' },
  en: { title:'Page not found', copy:'The page may have moved, been removed, or the address may be incorrect.', home:'Back home', docs:'Read the docs', language:'Select language' },
  ar: { title:'الصفحة غير موجودة', copy:'ربما انتقلت الصفحة التي تحاول الوصول إليها أو حُذفت أو كان العنوان غير صحيح.', home:'العودة إلى الصفحة الرئيسية', docs:'قراءة الوثائق', language:'اختيار اللغة' },
  fr: { title:'Page introuvable', copy:"La page a peut-être été déplacée, supprimée ou l'adresse est incorrecte.", home:'Retour à l\'accueil', docs:'Lire la documentation', language:'Choisir la langue' },
  ru: { title:'Страница не найдена', copy:'Страница могла быть перемещена, удалена или адрес введён неверно.', home:'На главную', docs:'Читать документацию', language:'Выбор языка' },
  ja: { title:'ページが見つかりません', copy:'アクセスしたページは移動・削除されたか、アドレスが間違っている可能性があります。', home:'ホームへ戻る', docs:'ドキュメントを読む', language:'言語を選択' },
  ko: { title:'페이지를 찾을 수 없습니다', copy:'방문한 페이지가 이동·삭제되었거나 주소가 잘못되었을 수 있습니다.', home:'홈으로 돌아가기', docs:'문서 읽기', language:'언어 선택' },
};
---
<!doctype html><html lang="zh-CN" data-theme="dark" data-locale="zh-cn"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,follow"/><meta name="color-scheme" content="dark light"/><link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml"/><title>404 · QingZoneX</title><script is:inline set:html={bootstrap}></script><script is:inline>try { const state=window.__QINGZONEX_I18N__; if(state?.current){ const langs={'zh-cn':'zh-CN','zh-tw':'zh-TW',en:'en',ar:'ar',fr:'fr',ru:'ru',ja:'ja',ko:'ko'}; document.documentElement.dataset.locale=state.current; document.documentElement.lang=langs[state.current]||'zh-CN'; document.documentElement.dir=state.current==='ar'?'rtl':'ltr'; } const stored=localStorage.getItem('starlight-theme'); document.documentElement.dataset.theme=stored||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark'); } catch {}</script><style>.not-found{min-height:100vh;display:grid;place-items:center;padding:40px 0}.not-found-card{width:min(680px,calc(100% - 32px));padding:48px;border:1px solid var(--line);border-radius:24px;background:var(--bg-elevated);text-align:center;box-shadow:var(--shadow)}.not-found-code{color:var(--accent);font:800 13px/1 ui-monospace,monospace}.not-found-card h1{margin:16px 0 10px;font-size:clamp(38px,7vw,64px)}.not-found-card p{color:var(--muted-strong)}[data-locale-panel]{display:none}html[data-locale='zh-cn'] [data-locale-panel='zh-cn'],html[data-locale='zh-tw'] [data-locale-panel='zh-tw'],html[data-locale='en'] [data-locale-panel='en'],html[data-locale='ar'] [data-locale-panel='ar'],html[data-locale='fr'] [data-locale-panel='fr'],html[data-locale='ru'] [data-locale-panel='ru'],html[data-locale='ja'] [data-locale-panel='ja'],html[data-locale='ko'] [data-locale-panel='ko']{display:block}.not-found-tools{margin-top:26px;display:flex;align-items:center;gap:10px;justify-content:center;flex-wrap:wrap}@media(max-width:560px){.not-found-card{padding:36px 20px}.not-found-tools{align-items:stretch;flex-direction:column}.not-found-tools :global(.locale-switcher),.not-found-tools .button{width:100%}}</style></head><body><main class="not-found"><div class="not-found-card"><div class="not-found-code">404 · QingZoneX</div>{SUPPORTED_LOCALES.map((locale)=><section data-locale-panel={locale}><h1>{messages[locale].title}</h1><p>{messages[locale].copy}</p><div class="not-found-tools"><LocaleSwitcher locale={locale} route="" label={messages[locale].language}/><a class="button primary" href={localePath(locale,'',base)}>{messages[locale].home}</a><a class="button secondary" href={localePath(locale,'docs/',base)}>{messages[locale].docs}</a></div></section>)}</div></main></body></html>
