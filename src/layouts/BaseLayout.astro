---
import '../styles/global.css';
import { GITHUB_ORG_URL, QTABLE_GITHUB_URL, withBase } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'QingZoneX — Open source, AI-native project & work management',
  description = 'QingZoneX is opening QTable and QTableUI: an AI-native, multidimensional-table foundation for project and work management.',
  image = 'og.svg',
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const socialImage = Astro.site ? new URL(withBase(image), Astro.site) : new URL(withBase(image), Astro.url);
const currentPath = Astro.url.pathname;
const nav = [
  { label: 'QTable', href: withBase('qtable/') },
  { label: 'QTableUI', href: withBase('qtable-ui/') },
  { label: 'Examples', href: withBase('examples/') },
  { label: 'Docs', href: withBase('docs/') },
  { label: 'Roadmap', href: withBase('roadmap/') },
];
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#07111f" />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="QingZoneX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={socialImage.toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.toString()} />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('starlight-theme');
          const systemLight = matchMedia('(prefers-color-scheme: light)').matches;
          document.documentElement.dataset.theme = stored || (systemLight ? 'light' : 'dark');
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" data-header>
      <div class="shell nav-shell">
        <a class="brand" href={withBase()} aria-label="QingZoneX home">
          <img src={withBase('logo.svg')} width="34" height="34" alt="" />
          <span>QingZoneX</span>
          <span class="preview-pill">Open Source Preview</span>
        </a>

        <button class="mobile-menu" type="button" aria-expanded="false" aria-controls="primary-nav" data-menu-button>
          <span class="sr-only">Toggle navigation</span>
          <span></span><span></span><span></span>
        </button>

        <nav id="primary-nav" class="primary-nav" aria-label="Primary" data-nav>
          {nav.map((item) => (
            <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>

        <div class="nav-actions">
          <button class="icon-button" type="button" title="Toggle color theme" aria-label="Toggle color theme" data-theme-button>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.91-.1-1.35A7 7 0 0 1 12 3Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <a class="github-button" href={GITHUB_ORG_URL} target="_blank" rel="noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.23.7-3.91-1.37-3.91-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.2 1.78 1.2 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.74-1.55-2.58-.29-5.29-1.29-5.29-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18A10.9 10.9 0 0 1 12 6.11c.98 0 1.95.13 2.86.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.72 5.39-5.3 5.68.42.36.79 1.07.79 2.16v3.24c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
            <span>GitHub</span>
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="brand footer-brand" href={withBase()}>
            <img src={withBase('logo.svg')} width="32" height="32" alt="" />
            <span>QingZoneX</span>
          </a>
          <p>Open-source foundations for AI-native project and work management.</p>
        </div>
        <div class="footer-links">
          <div><strong>Products</strong><a href={withBase('qtable/')}>QTable</a><a href={withBase('qtable-ui/')}>QTableUI</a><a href={withBase('examples/')}>Examples</a></div>
          <div><strong>Developers</strong><a href={withBase('docs/')}>Documentation</a><a href={withBase('roadmap/')}>Roadmap</a><a href={QTABLE_GITHUB_URL}>QTable source</a></div>
          <div><strong>Community</strong><a href={GITHUB_ORG_URL}>GitHub organization</a><a href={`${QTABLE_GITHUB_URL}/issues`}>Issues</a><a href={`${QTABLE_GITHUB_URL}/blob/main/CONTRIBUTING.md`}>Contributing</a></div>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>QTable & QTableUI · Apache License 2.0</span>
        <span>Alpha / Open Source Preview</span>
      </div>
    </footer>

    <script>
      const themeButton = document.querySelector('[data-theme-button]');
      themeButton?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('starlight-theme', next); } catch {}
      });

      const menuButton = document.querySelector('[data-menu-button]');
      const nav = document.querySelector('[data-nav]');
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open', !open);
      });

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        if (event.target.closest('[data-nav] a')) {
          menuButton?.setAttribute('aria-expanded', 'false');
          nav?.classList.remove('open');
        }
      });
    </script>
  </body>
</html>
