---
import '../styles/global.css';
import '../styles/i18n.css';
import LocaleSwitcher from '../components/LocaleSwitcher.astro';
import { GITHUB_ORG_URL, QTABLE_GITHUB_URL, withBase } from '../lib/site';
import { LOCALE_SETTINGS, SUPPORTED_LOCALES, localeBootstrapScript, localePath } from '../lib/i18n.mjs';
import { getPortalContent, type PortalLocale } from '../lib/portal-content';

interface Props {
  locale: PortalLocale;
  route?: string;
  title?: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
}

const { locale, route = '', image = 'og.svg', noIndex = false } = Astro.props;
const copy = getPortalContent(locale).layout;
const title = Astro.props.title ?? copy.metaTitle;
const description = Astro.props.description ?? copy.metaDescription;
const base = import.meta.env.BASE_URL || '/';
const currentUrlPath = localePath(locale, route, base);
const canonical = Astro.site ? new URL(currentUrlPath, Astro.site) : new URL(currentUrlPath, Astro.url);
const socialImage = Astro.site ? new URL(withBase(image), Astro.site) : new URL(withBase(image), Astro.url);
const currentPath = Astro.url.pathname;
const localeInfo = LOCALE_SETTINGS[locale];
const bootstrap = localeBootstrapScript(base);
const localHref = (path = '') => localePath(locale, path, base);
const nav = [
  { label: 'QTable', href: localHref('qtable/') },
  { label: 'QTableUI', href: localHref('qtable-ui/') },
  { label: copy.nav.examples, href: localHref('examples/') },
  { label: copy.nav.docs, href: localHref('docs/') },
  { label: copy.nav.roadmap, href: localHref('roadmap/') },
];
const alternates = SUPPORTED_LOCALES.map((code) => ({ code, settings: LOCALE_SETTINGS[code], href: localePath(code, route, base) }));
---
<!doctype html>
<html lang={localeInfo.lang} data-theme="dark" data-locale={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#07111f" />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="QingZoneX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={socialImage.toString()} />
    <meta property="og:locale" content={localeInfo.ogLocale} />
    {alternates.filter((item) => item.code !== locale).map((item) => <meta property="og:locale:alternate" content={item.settings.ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.toString()} />
    <link rel="canonical" href={canonical.toString()} />
    {alternates.map((item) => <link rel="alternate" hreflang={item.settings.lang} href={Astro.site ? new URL(item.href, Astro.site).toString() : item.href} />)}
    <link rel="alternate" hreflang="x-default" href={Astro.site ? new URL(localePath('zh-cn', route, base), Astro.site).toString() : localePath('zh-cn', route, base)} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline set:html={bootstrap}></script>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('starlight-theme');
          const systemLight = matchMedia('(prefers-color-scheme: light)').matches;
          document.documentElement.dataset.theme = stored || (systemLight ? 'light' : 'dark');
        } catch { document.documentElement.dataset.theme = 'dark'; }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.skip}</a>
    <header class="site-header" data-header>
      <div class="shell nav-shell">
        <a class="brand" href={localHref()} aria-label={copy.home}><img src={withBase('logo.svg')} width="34" height="34" alt="" /><span>QingZoneX</span><span class="preview-pill">{copy.preview}</span></a>
        <button class="mobile-menu" type="button" aria-expanded="false" aria-controls="primary-nav" data-menu-button><span class="sr-only">{copy.toggleNav}</span><span></span><span></span><span></span></button>
        <nav id="primary-nav" class="primary-nav" aria-label={copy.primaryNav} data-nav>{nav.map((item) => <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>)}</nav>
        <div class="nav-actions">
          <LocaleSwitcher locale={locale} route={route} label={copy.language} />
          <button class="icon-button" type="button" title={copy.toggleTheme} aria-label={copy.toggleTheme} data-theme-button><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.91-.1-1.35A7 7 0 0 1 12 3Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <a class="github-button" href={GITHUB_ORG_URL} target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.23.7-3.91-1.37-3.91-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.2 1.78 1.2 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.74-1.55-2.58-.29-5.29-1.29-5.29-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18A10.9 10.9 0 0 1 12 6.11c.98 0 1.95.13 2.86.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.72 5.39-5.3 5.68.42.36.79 1.07.79 2.16v3.24c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg><span>GitHub</span></a>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="shell footer-grid"><div><a class="brand footer-brand" href={localHref()}><img src={withBase('logo.svg')} width="32" height="32" alt="" /><span>QingZoneX</span></a><p>{copy.footerTagline}</p></div><div class="footer-links"><div><strong>{copy.products}</strong><a href={localHref('qtable/')}>QTable</a><a href={localHref('qtable-ui/')}>QTableUI</a><a href={localHref('examples/')}>{copy.examples}</a></div><div><strong>{copy.developers}</strong><a href={localHref('docs/')}>{copy.documentation}</a><a href={localHref('roadmap/')}>{copy.roadmap}</a><a href={QTABLE_GITHUB_URL}>{copy.qtableSource}</a></div><div><strong>{copy.community}</strong><a href={GITHUB_ORG_URL}>{copy.githubOrg}</a><a href={`${QTABLE_GITHUB_URL}/issues`}>{copy.issues}</a><a href={`${QTABLE_GITHUB_URL}/blob/main/CONTRIBUTING.md`}>{copy.contributing}</a></div></div></div><div class="shell footer-bottom"><span>QTable & QTableUI · Apache License 2.0</span><span>{copy.alpha}</span></div></footer>
    <script>
      const themeButton = document.querySelector('[data-theme-button]');
      themeButton?.addEventListener('click', () => { const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light'; document.documentElement.dataset.theme = next; try { localStorage.setItem('starlight-theme', next); } catch {} });
      const menuButton = document.querySelector('[data-menu-button]');
      const nav = document.querySelector('[data-nav]');
      menuButton?.addEventListener('click', () => { const open = menuButton.getAttribute('aria-expanded') === 'true'; menuButton.setAttribute('aria-expanded', String(!open)); nav?.classList.toggle('open', !open); });
      document.addEventListener('click', (event) => { if (!(event.target instanceof Element)) return; if (event.target.closest('[data-nav] a')) { menuButton?.setAttribute('aria-expanded', 'false'); nav?.classList.remove('open'); } });
    </script>
  </body>
</html>
