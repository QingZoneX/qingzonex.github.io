---
import { LOCALE_SETTINGS, SUPPORTED_LOCALES, localePath } from '../lib/i18n.mjs';

interface Props {
  locale: 'zh-cn' | 'zh-tw' | 'en';
  route?: string;
  label: string;
  compact?: boolean;
}

const { locale, route = '', label, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL || '/';
const current = LOCALE_SETTINGS[locale];
const options = SUPPORTED_LOCALES.map((code) => ({
  code,
  ...LOCALE_SETTINGS[code],
  href: localePath(code, route, base),
  selected: code === locale,
}));
---
<div class:list={['locale-switcher', { compact }]} data-locale-switcher>
  <button
    class="locale-trigger"
    type="button"
    aria-label={label}
    aria-haspopup="menu"
    aria-expanded="false"
    data-locale-trigger
  >
    <svg class="locale-globe" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="8.5" />
      <path d="M3.8 12h16.4M12 3.5c2.2 2.2 3.4 5 3.4 8.5S14.2 18.3 12 20.5M12 3.5c-2.2 2.2-3.4 5-3.4 8.5s1.2 6.3 3.4 8.5" />
    </svg>
    <span class="locale-trigger-label">{current.label}</span>
    <svg class="locale-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
  </button>

  <div class="locale-menu" role="menu" aria-label={label} data-locale-menu hidden>
    <div class="locale-menu-title" aria-hidden="true">{label}</div>
    {options.map((option) => (
      <a
        class:list={['locale-option', { active: option.selected }]}
        href={option.href}
        role="menuitemradio"
        aria-checked={String(option.selected)}
        data-locale-option
        data-locale={option.code}
      >
        <span class="locale-badge" aria-hidden="true">{option.badge}</span>
        <span class="locale-option-copy">
          <strong>{option.label}</strong>
          <small>{option.lang}</small>
        </span>
        <svg class="locale-check" viewBox="0 0 16 16" aria-hidden="true"><path d="m3.5 8.2 2.6 2.6 6.4-6.4" /></svg>
      </a>
    ))}
  </div>
</div>

<style>
  .locale-switcher {
    position: relative;
    display: inline-flex;
    flex: 0 0 auto;
  }

  .locale-trigger {
    min-width: 132px;
    height: 40px;
    padding: 0 10px 0 11px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: color-mix(in srgb, var(--bg-elevated) 88%, transparent);
    color: var(--muted-strong);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    box-shadow: inset 0 1px rgba(255,255,255,.035);
    transition: border-color .18s ease, background .18s ease, color .18s ease, transform .18s ease;
  }

  .locale-trigger:hover,
  .locale-trigger[aria-expanded='true'] {
    border-color: var(--line-strong);
    background: var(--bg-soft);
    color: var(--text);
  }

  .locale-trigger:hover { transform: translateY(-1px); }

  .locale-trigger:focus-visible,
  .locale-option:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--accent) 72%, transparent);
    outline-offset: 2px;
  }

  .locale-globe {
    width: 17px;
    height: 17px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.55;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .locale-trigger-label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 12px;
    font-weight: 760;
    letter-spacing: -.01em;
  }

  .locale-chevron {
    width: 13px;
    height: 13px;
    margin-left: auto;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform .18s ease;
  }

  .locale-trigger[aria-expanded='true'] .locale-chevron { transform: rotate(180deg); }

  .locale-menu {
    position: absolute;
    z-index: 1000;
    top: calc(100% + 9px);
    right: 0;
    width: 206px;
    padding: 7px;
    border: 1px solid var(--line-strong);
    border-radius: 15px;
    background: color-mix(in srgb, var(--bg-elevated) 96%, transparent);
    box-shadow: 0 18px 48px rgba(0,0,0,.28), inset 0 1px rgba(255,255,255,.04);
    backdrop-filter: blur(18px);
    transform-origin: top right;
  }

  .locale-menu[hidden] { display: none; }

  .locale-menu-title {
    padding: 5px 8px 7px;
    color: var(--muted);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .locale-option {
    min-height: 48px;
    padding: 6px 8px;
    border-radius: 10px;
    display: grid;
    grid-template-columns: 30px minmax(0,1fr) 18px;
    gap: 9px;
    align-items: center;
    color: var(--muted-strong);
    text-decoration: none;
    transition: background .15s ease, color .15s ease;
  }

  .locale-option:hover { background: var(--bg-soft); color: var(--text); }
  .locale-option.active {
    color: var(--text);
    background: color-mix(in srgb, var(--accent-2) 13%, var(--bg-soft));
  }

  .locale-badge {
    width: 30px;
    height: 30px;
    border: 1px solid var(--line);
    border-radius: 9px;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--bg-soft) 84%, transparent);
    color: var(--muted-strong);
    font: 800 10px/1 ui-sans-serif, system-ui, sans-serif;
  }

  .locale-option.active .locale-badge {
    border-color: color-mix(in srgb, var(--accent-2) 38%, var(--line));
    color: var(--accent-2);
  }

  .locale-option-copy { min-width: 0; display: grid; gap: 1px; }
  .locale-option-copy strong { font-size: 12.5px; line-height: 1.25; }
  .locale-option-copy small { color: var(--muted); font-size: 9.5px; line-height: 1.25; }

  .locale-check {
    width: 16px;
    height: 16px;
    opacity: 0;
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .locale-option.active .locale-check { opacity: 1; }

  .compact .locale-trigger { min-width: 116px; }

  @media (max-width: 700px) {
    .locale-trigger {
      width: 40px;
      min-width: 40px;
      padding: 0;
      gap: 0;
    }
    .locale-trigger-label,
    .locale-chevron { display: none; }
    .locale-menu { right: -2px; width: 198px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .locale-trigger,
    .locale-chevron,
    .locale-option { transition: none; }
  }
</style>

<script>
  const switchers = [...document.querySelectorAll('[data-locale-switcher]')];

  const closeSwitcher = (root) => {
    if (!(root instanceof HTMLElement)) return;
    const trigger = root.querySelector('[data-locale-trigger]');
    const menu = root.querySelector('[data-locale-menu]');
    if (trigger instanceof HTMLButtonElement) trigger.setAttribute('aria-expanded', 'false');
    if (menu instanceof HTMLElement) menu.hidden = true;
  };

  const openSwitcher = (root, focusOption = false) => {
    if (!(root instanceof HTMLElement)) return;
    for (const other of switchers) if (other !== root) closeSwitcher(other);
    const trigger = root.querySelector('[data-locale-trigger]');
    const menu = root.querySelector('[data-locale-menu]');
    if (!(trigger instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;
    trigger.setAttribute('aria-expanded', 'true');
    menu.hidden = false;
    if (focusOption) {
      const active = menu.querySelector('.locale-option.active') || menu.querySelector('.locale-option');
      if (active instanceof HTMLElement) active.focus();
    }
  };

  for (const root of switchers) {
    if (!(root instanceof HTMLElement)) continue;
    const trigger = root.querySelector('[data-locale-trigger]');
    const menu = root.querySelector('[data-locale-menu]');
    if (!(trigger instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) continue;

    trigger.addEventListener('click', (event) => {
      event.stopPropagation();
      const open = trigger.getAttribute('aria-expanded') === 'true';
      if (open) closeSwitcher(root); else openSwitcher(root);
    });

    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openSwitcher(root, true);
      }
    });

    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('[data-locale-option]')) closeSwitcher(root);
    });

    menu.addEventListener('keydown', (event) => {
      const options = [...menu.querySelectorAll('[data-locale-option]')].filter((item) => item instanceof HTMLElement);
      if (!options.length) return;
      const current = options.indexOf(document.activeElement);
      if (event.key === 'Escape') {
        event.preventDefault();
        closeSwitcher(root);
        trigger.focus();
      } else if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        const delta = event.key === 'ArrowDown' ? 1 : -1;
        const next = current < 0 ? 0 : (current + delta + options.length) % options.length;
        options[next]?.focus();
      } else if (event.key === 'Home' || event.key === 'End') {
        event.preventDefault();
        options[event.key === 'Home' ? 0 : options.length - 1]?.focus();
      }
    });
  }

  document.addEventListener('click', (event) => {
    for (const root of switchers) {
      if (root instanceof HTMLElement && event.target instanceof Node && !root.contains(event.target)) closeSwitcher(root);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const root of switchers) closeSwitcher(root);
  });
</script>
