---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { QTABLE_GITHUB_URL, QTABLE_UI_GITHUB_URL } from '../../lib/site'; import { localePath } from '../../lib/i18n.mjs'; import { getPortalContent, type PortalLocale } from '../../lib/portal-content';
interface Props { locale: PortalLocale } const { locale }=Astro.props; const c=getPortalContent(locale).roadmap; const href=(p='')=>localePath(locale,p,import.meta.env.BASE_URL);
---
<BaseLayout locale={locale} route="roadmap/" title={c.metaTitle} description={c.metaDescription}><section class="page-hero"><div class="shell"><span class="eyebrow"><i class="eyebrow-dot"></i>{c.eyebrow}</span><h1>{c.heroA}<br/>{c.heroB}</h1><p>{c.heroCopy}</p><div class="page-actions"><a class="button primary" href={`${QTABLE_GITHUB_URL}/issues`}>{c.qtableIssues} →</a><a class="button secondary" href={`${QTABLE_UI_GITHUB_URL}/issues`}>{c.uiIssues}</a></div></div></section><section class="section"><div class="shell"><div class="section-head"><span class="kicker">{c.implemented.kicker}</span><h2>{c.implemented.title}</h2><p>{c.implemented.description}</p></div><div class="feature-grid">{c.implemented.features.map(([title,d])=><article class="feature-card"><h3>{title}</h3><p>{d}</p></article>)}</div></div></section><section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">{c.activeKicker}</span><h2>{c.activeTitle}</h2></div><div class="roadmap">{c.active.map(([title,d,url])=><article class="roadmap-item"><span class="roadmap-tag active">{c.phaseNow}</span><div><h3>{title}</h3><p>{d}</p></div><a class="text-link" href={url}>{c.issue} →</a></article>)}</div></div></section><section class="section"><div class="shell"><div class="section-head"><span class="kicker">{c.nextKicker}</span><h2>{c.nextTitle}</h2></div><div class="roadmap">{c.next.map(([title,d,url])=><article class="roadmap-item"><span class="roadmap-tag">{c.phaseNext}</span><div><h3>{title}</h3><p>{d}</p></div><a class="text-link" href={url}>{c.issue} →</a></article>)}</div></div></section><section class="cta"><div class="shell"><div class="cta-card"><h2>{c.ctaTitle}</h2><p>{c.ctaDescription}</p><div class="hero-actions"><a class="button primary" href={href('docs/project/feature-matrix/')}>{c.matrix} →</a><a class="button secondary" href={href('docs/project/release-status/')}>{c.status}</a></div></div></div></section></BaseLayout>
