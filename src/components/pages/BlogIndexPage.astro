---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { PortalLocale } from '../../lib/current-portal-content';
import { localePath } from '../../lib/i18n.mjs';

interface Props { locale: PortalLocale }
const { locale } = Astro.props;
const base = import.meta.env.BASE_URL || '/';
const href = (path = '') => localePath(locale, path, base);
const copy = {
  'zh-cn': {
    metaTitle: 'QingZoneX 技术博客', metaDescription: '关于 QTable、AI Native 工作系统、Agent Runtime、数据模型、安全与开源工程实践的深度文章。',
    eyebrow: 'QingZoneX Engineering', title: '构建 QTable：一个 AI Native 工作系统的设计与实现',
    intro: '这不是产品功能公告，而是一组围绕真实工程问题展开的文章：为什么要做 QTable、AI 如何安全操作业务数据、Context 如何建立、Agent 如何执行工作，以及一个项目如何真正走向开源。',
    series: '系列文章', read: '阅读全文', source: 'Markdown 原文保存在本仓库，外部技术社区内容将以此处作为 canonical source。',
    articles: [
      {
        number: '06',
        title: 'Grid、Kanban、Gantt 不应该各存一份数据：QTable 的 View 为什么只是同一事实的不同投影',
        description: '同一条任务在 Grid 里是一行，在 Kanban 里是一张卡片，在 Gantt 里是一段时间条。这篇结合 QTable 当前 Record / View 模型与 QTableUI 实现，拆解业务状态和视图状态为什么必须分开，以及 Kanban 排序、Gantt 映射、实时同步应该如何围绕同一份业务事实工作。',
        date: '2026 年 9 月 27 日',
        tags: ['View Model', 'Data Consistency', 'QTable'],
        path: 'blog/one-truth-multiple-views/',
      },
      {
        number: '05',
        title: 'Agent 不是一串函数调用：QTable 的 Multi Tool Chain Runtime 如何把工具执行变成工作流',
        description: '真实 Agent 往往需要拆任务、估工期、读 Schema、生成 Gantt 再写入 Record。这篇结合 QTable 当前 Multi Tool Chain Runtime，拆解 ToolChainPlan、依赖与数据传递、Retry / Confirm / Rollback、运行时可观测性，以及当前 DAG 并行调度仍需要补齐的部分。',
        date: '2026 年 9 月 27 日',
        tags: ['Tool Chain', 'Agent Runtime', 'QTable'],
        path: 'blog/multi-tool-chain-runtime/',
      },
      {
        number: '04',
        title: 'Context 不是把更多数据塞进 Prompt：QTable 的 Context Engine 如何建立真实业务上下文',
        description: 'Agent 真正进入业务系统后，关键不是模型能记住多少，而是系统如何明确当前用户、Workspace、Table、View、Conversation 与权限边界。这篇结合 QTable 当前 Context Engine，拆解 Scope、对话压缩、Cache / Session / Snapshot，以及上下文如何注入 Agent Runtime。',
        date: '2026 年 9 月 27 日',
        tags: ['Context Engine', 'Agent Runtime', 'QTable'],
        path: 'blog/context-engine-business-context/',
      },
      {
        number: '03',
        title: '为什么 AI 写操作不能直接落库：QTable 的 Preview → Confirm → Apply',
        description: 'AI 开始修改业务数据后，真正危险的是过期、越权或理解错误的决定变成业务事实。这篇结合 QTable 当前 Action Plan、record version、权限重校验与 ChangeSet 实现，拆解 Preview → Confirm → Apply 为什么是一条执行边界。',
        date: '2026 年 9 月 27 日',
        tags: ['AI 安全', 'Action Plan', 'QTable'],
        path: 'blog/preview-confirm-apply-ai-writes/',
      },
      {
        number: '02',
        title: '为什么多维表格适合作为 AI Agent 的业务数据底座',
        description: 'Agent 真正进入业务系统后，难点不是生成文字，而是理解对象、关系、权限和状态。这篇从 QTable 当前的 Field / Record / View / Relation / Permission 模型出发，讨论多维表格为什么是自然语言与可执行工作之间很实用的一层。',
        date: '2026 年 9 月 16 日',
        tags: ['数据模型', 'Agent', 'QTable'],
        path: 'blog/multidimensional-table-agent-foundation/',
      },
      {
        number: '01',
        title: '为什么我又做了一个开源多维表格：QTable 想解决的其实不是「表格」问题',
        description: 'Airtable、Notion、飞书多维表格已经很成熟了，为什么还值得做 QTable？第一篇从这个问题出发，解释 QTable 真正想构建的是怎样的 AI Native 工作底座。',
        date: '2026 年 9 月 13 日',
        tags: ['产品思考', 'AI Native', 'QTable'],
        path: 'blog/why-qtable/',
      },
    ],
  },
  'zh-tw': {
    metaTitle: 'QingZoneX 技術部落格', metaDescription: '關於 QTable、AI Native 工作系統、Agent Runtime、資料模型、安全與開源工程實踐的深度文章。',
    eyebrow: 'QingZoneX Engineering', title: '構建 QTable：一個 AI Native 工作系統的設計與實作',
    intro: '這不是產品功能公告，而是一組圍繞真實工程問題展開的文章：為什麼要做 QTable、AI 如何安全操作業務資料、Context 如何建立、Agent 如何執行工作，以及一個專案如何真正走向開源。',
    series: '系列文章', read: '閱讀全文', source: 'Markdown 原文保存在本倉庫，外部技術社群內容將以此處作為 canonical source。',
    articles: [
      {
        number: '06',
        title: 'Grid、Kanban、Gantt 不應該各存一份資料：QTable 的 View 為什麼只是同一事實的不同投影',
        description: '同一條任務在 Grid 裡是一列，在 Kanban 裡是一張卡片，在 Gantt 裡是一段時間條。這篇結合 QTable 目前 Record / View Model 與 QTableUI 實作，拆解 Business State 和 View State 為什麼必須分開，以及 Kanban Order、Gantt Mapping、Realtime Sync 如何圍繞同一份業務事實工作。',
        date: '2026 年 9 月 27 日',
        tags: ['View Model', 'Data Consistency', 'QTable'],
        path: 'blog/one-truth-multiple-views/',
      },
      {
        number: '05',
        title: 'Agent 不是一串函式呼叫：QTable 的 Multi Tool Chain Runtime 如何把工具執行變成工作流',
        description: '真實 Agent 往往需要拆任務、估工期、讀 Schema、產生 Gantt 再寫入 Record。這篇結合 QTable 目前 Multi Tool Chain Runtime，拆解 ToolChainPlan、Dependency 與 Data Passing、Retry / Confirm / Rollback、執行可觀測性，以及目前 DAG 平行調度仍需要補齊的部分。',
        date: '2026 年 9 月 27 日',
        tags: ['Tool Chain', 'Agent Runtime', 'QTable'],
        path: 'blog/multi-tool-chain-runtime/',
      },
      {
        number: '04',
        title: 'Context 不是把更多資料塞進 Prompt：QTable 的 Context Engine 如何建立真實業務上下文',
        description: 'Agent 真正進入業務系統後，關鍵不是模型能記住多少，而是系統如何明確目前使用者、Workspace、Table、View、Conversation 與權限邊界。這篇結合 QTable 目前 Context Engine，拆解 Scope、對話壓縮、Cache / Session / Snapshot，以及上下文如何注入 Agent Runtime。',
        date: '2026 年 9 月 27 日',
        tags: ['Context Engine', 'Agent Runtime', 'QTable'],
        path: 'blog/context-engine-business-context/',
      },
      {
        number: '03',
        title: '為什麼 AI 寫入不能直接落庫：QTable 的 Preview → Confirm → Apply',
        description: 'AI 開始修改業務資料後，真正危險的是過期、越權或理解錯誤的決定成為業務事實。這篇結合 QTable 目前的 Action Plan、record version、權限重驗證與 ChangeSet 實作，拆解 Preview → Confirm → Apply 為什麼是一條執行邊界。',
        date: '2026 年 9 月 27 日',
        tags: ['AI 安全', 'Action Plan', 'QTable'],
        path: 'blog/preview-confirm-apply-ai-writes/',
      },
      {
        number: '02',
        title: '為什麼多維表格適合作為 AI Agent 的業務資料底座',
        description: 'Agent 真正進入業務系統後，難點不是產生文字，而是理解物件、關係、權限和狀態。這篇從 QTable 目前的 Field / Record / View / Relation / Permission 模型出發，討論多維表格為什麼是自然語言與可執行工作之間很實用的一層。',
        date: '2026 年 9 月 16 日',
        tags: ['資料模型', 'Agent', 'QTable'],
        path: 'blog/multidimensional-table-agent-foundation/',
      },
      {
        number: '01',
        title: '為什麼我又做了一個開源多維表格：QTable 想解決的其實不是「表格」問題',
        description: 'Airtable、Notion、飛書多維表格已經很成熟了，為什麼還值得做 QTable？第一篇從這個問題出發，解釋 QTable 真正想構建的是怎樣的 AI Native 工作底座。',
        date: '2026 年 9 月 13 日',
        tags: ['產品思考', 'AI Native', 'QTable'],
        path: 'blog/why-qtable/',
      },
    ],
  },
  en: {
    metaTitle: 'QingZoneX Engineering Blog', metaDescription: 'Deep dives into QTable, AI-native work systems, agent runtimes, data models, security, and open-source engineering.',
    eyebrow: 'QingZoneX Engineering', title: 'Building QTable: Engineering an AI-Native Work System',
    intro: 'This is not a stream of product announcements. It is a series about real engineering questions: why QTable exists, how AI can safely operate business data, how context is built, how agents execute work, and what it takes to make a project genuinely open source.',
    series: 'Series', read: 'Read article', source: 'The canonical Markdown source lives in this repository. Syndicated copies on external engineering communities should point back here.',
    articles: [
      {
        number: '06',
        title: 'Grid, Kanban, and Gantt Should Not Store Three Copies of the Data: Why a QTable View Is Only a Projection',
        description: 'The same task is a row in Grid, a card in Kanban, and a bar in Gantt. This article follows QTable’s current Record / View model and QTableUI implementation to separate business state from view state, including Kanban ordering, Gantt field mapping, realtime convergence, and current consistency gaps.',
        date: 'September 27, 2026',
        tags: ['View Model', 'Data Consistency', 'QTable'],
        path: 'blog/one-truth-multiple-views/',
      },
      {
        number: '05',
        title: 'An Agent Is Not a Sequence of Function Calls: How QTable Turns Tools into a Runtime',
        description: 'Real agent work often means task splitting, estimation, Schema inspection, Gantt generation, and Record creation. This article follows QTable’s current Multi Tool Chain Runtime through ToolChainPlan, dependencies, data passing, retry / confirmation / rollback, observability, and the DAG scheduling work that is still incomplete.',
        date: 'September 27, 2026',
        tags: ['Tool Chain', 'Agent Runtime', 'QTable'],
        path: 'blog/multi-tool-chain-runtime/',
      },
      {
        number: '04',
        title: 'Context Is Not More Prompt Stuffing: How QTable Builds Real Business Context for Agents',
        description: 'Once an agent enters a business system, the hard part is not how much the model can remember. This article follows QTable’s current Context Engine through scope, permission-aware Table context, conversation compression, Cache / Session / Snapshot, and runtime injection.',
        date: 'September 27, 2026',
        tags: ['Context Engine', 'Agent Runtime', 'QTable'],
        path: 'blog/context-engine-business-context/',
      },
      {
        number: '03',
        title: 'Why AI Writes Should Not Go Straight to the Database: QTable\'s Preview → Confirm → Apply',
        description: 'Once AI can change business data, stale, unauthorized, or misunderstood decisions can become durable facts. This article follows QTable’s current Action Plan, record-version checks, permission revalidation, and ChangeSet audit path to explain why Preview → Confirm → Apply is an execution boundary.',
        date: 'September 27, 2026',
        tags: ['AI safety', 'Action Plan', 'QTable'],
        path: 'blog/preview-confirm-apply-ai-writes/',
      },
      {
        number: '02',
        title: 'Why Multidimensional Tables Make a Good Business Data Foundation for AI Agents',
        description: 'Once an agent enters a real business system, fluent generation is not the hard part. This article starts from QTable’s current Field / Record / View / Relation / Permission model and asks why multidimensional tables make a practical layer between natural-language intent and executable work.',
        date: 'September 16, 2026',
        tags: ['Data model', 'Agents', 'QTable'],
        path: 'blog/multidimensional-table-agent-foundation/',
      },
      {
        number: '01',
        title: 'Why Build Another Open-Source Multidimensional Table? QTable Is Not Really About Tables',
        description: 'Airtable, Notion, and modern multidimensional-table products are already mature. Why build QTable? The first article explains the product thesis behind an AI-native structured work foundation.',
        date: 'September 13, 2026',
        tags: ['Product thinking', 'AI Native', 'QTable'],
        path: 'blog/why-qtable/',
      },
    ],
  },
}[locale];
---
<BaseLayout locale={locale} route="blog/" title={copy.metaTitle} description={copy.metaDescription}>
  <section class="blog-index shell">
    <header class="blog-index-hero"><span class="blog-eyebrow">{copy.eyebrow}</span><h1>{copy.title}</h1><p>{copy.intro}</p></header>
    <div class="blog-section-head"><span>{copy.series}</span><span>06 / 10</span></div>
    <div class="article-list">
      {copy.articles.map((article) => (
        <article class="article-card">
          <div class="article-number">{article.number}</div>
          <div class="article-copy">
            <div class="article-tags">{article.tags.map((tag) => <span>{tag}</span>)}</div>
            <h2>{article.title}</h2>
            <p>{article.description}</p>
            <div class="article-footer"><span>{article.date}</span><a href={href(article.path)}>{copy.read} →</a></div>
          </div>
        </article>
      ))}
    </div>
    <p class="canonical-note">{copy.source}</p>
  </section>
</BaseLayout>

<style>
  .blog-index{max-width:1080px;padding-top:86px;padding-bottom:110px}.blog-index-hero{max-width:900px;margin-bottom:70px}.blog-eyebrow{display:inline-block;margin-bottom:18px;font-size:.82rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase;color:#6ea8ff}.blog-index-hero h1{margin:0;font-size:clamp(2.4rem,5.7vw,5rem);line-height:1.03;letter-spacing:-.045em}.blog-index-hero p{max-width:820px;margin:24px 0 0;font-size:1.12rem;line-height:1.8;color:var(--text-muted)}.blog-section-head{display:flex;justify-content:space-between;gap:20px;margin-bottom:18px;padding-bottom:12px;border-bottom:1px solid var(--border);font-size:.84rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--text-muted)}.article-list{display:grid;gap:18px}.article-card{display:grid;grid-template-columns:92px 1fr;gap:28px;padding:34px;border:1px solid var(--border);border-radius:22px;background:rgba(255,255,255,.035);transition:transform .2s ease,border-color .2s ease}.article-card:hover{transform:translateY(-2px);border-color:rgba(110,168,255,.55)}.article-number{font-size:3.1rem;font-weight:800;line-height:1;color:rgba(110,168,255,.65)}.article-tags{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}.article-tags span{padding:5px 9px;border:1px solid var(--border);border-radius:999px;font-size:.76rem;color:var(--text-muted)}.article-copy h2{max-width:790px;margin:0;font-size:clamp(1.7rem,3vw,2.6rem);line-height:1.22;letter-spacing:-.025em}.article-copy p{max-width:760px;margin:16px 0 0;line-height:1.75;color:var(--text-muted)}.article-footer{display:flex;justify-content:space-between;gap:20px;align-items:center;margin-top:28px;font-size:.92rem;color:var(--text-muted)}.article-footer a{font-weight:700;color:#6ea8ff;text-decoration:none}.canonical-note{max-width:760px;margin:26px 0 0;font-size:.86rem;line-height:1.7;color:var(--text-muted)}@media(max-width:700px){.blog-index{padding-top:52px}.article-card{grid-template-columns:1fr;padding:24px}.article-number{font-size:2rem}.article-footer{align-items:flex-start;flex-direction:column}}
</style>
