---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { PortalLocale } from '../../lib/current-portal-content';
import { localePath } from '../../lib/i18n.mjs';

interface Props { locale: PortalLocale }
const { locale } = Astro.props;
const base = import.meta.env.BASE_URL || '/';
const href = (path = '') => localePath(locale, path, base);
const copy = {
  'zh-cn': {
    metaTitle: 'QingZoneX 技术博客', metaDescription: '关于 QTable、AI Native 工作系统、Agent Runtime、数据模型、安全与开源工程实践的深度文章。',
    eyebrow: 'QingZoneX Engineering', title: '构建 QTable：一个 AI Native 工作系统的设计与实现',
    intro: '这不是产品功能公告，而是一组围绕真实工程问题展开的文章：为什么要做 QTable、AI 如何安全操作业务数据、Context 如何建立、Agent 如何执行工作，以及一个项目如何真正走向开源。',
    series: '系列文章', read: '阅读全文', articleTitle: '为什么我又做了一个开源多维表格：QTable 想解决的其实不是「表格」问题',
    articleDescription: 'Airtable、Notion、飞书多维表格已经很成熟了，为什么还值得做 QTable？第一篇从这个问题出发，解释 QTable 真正想构建的是怎样的 AI Native 工作底座。',
    date: '2026 年 9 月 13 日', tag1: '产品思考', tag2: 'AI Native', tag3: 'QTable', source: 'Markdown 原文保存在本仓库，外部技术社区内容将以此处作为 canonical source。',
  },
  'zh-tw': {
    metaTitle: 'QingZoneX 技術部落格', metaDescription: '關於 QTable、AI Native 工作系統、Agent Runtime、資料模型、安全與開源工程實踐的深度文章。',
    eyebrow: 'QingZoneX Engineering', title: '構建 QTable：一個 AI Native 工作系統的設計與實作',
    intro: '這不是產品功能公告，而是一組圍繞真實工程問題展開的文章：為什麼要做 QTable、AI 如何安全操作業務資料、Context 如何建立、Agent 如何執行工作，以及一個專案如何真正走向開源。',
    series: '系列文章', read: '閱讀全文', articleTitle: '為什麼我又做了一個開源多維表格：QTable 想解決的其實不是「表格」問題',
    articleDescription: 'Airtable、Notion、飛書多維表格已經很成熟了，為什麼還值得做 QTable？第一篇從這個問題出發，解釋 QTable 真正想構建的是怎樣的 AI Native 工作底座。',
    date: '2026 年 9 月 13 日', tag1: '產品思考', tag2: 'AI Native', tag3: 'QTable', source: 'Markdown 原文保存在本倉庫，外部技術社群內容將以此處作為 canonical source。',
  },
  en: {
    metaTitle: 'QingZoneX Engineering Blog', metaDescription: 'Deep dives into QTable, AI-native work systems, agent runtimes, data models, security, and open-source engineering.',
    eyebrow: 'QingZoneX Engineering', title: 'Building QTable: Engineering an AI-Native Work System',
    intro: 'This is not a stream of product announcements. It is a series about real engineering questions: why QTable exists, how AI can safely operate business data, how context is built, how agents execute work, and what it takes to make a project genuinely open source.',
    series: 'Series', read: 'Read article', articleTitle: 'Why Build Another Open-Source Multidimensional Table? QTable Is Not Really About Tables',
    articleDescription: 'Airtable, Notion, and modern multidimensional-table products are already mature. Why build QTable? The first article explains the product thesis behind an AI-native structured work foundation.',
    date: 'September 13, 2026', tag1: 'Product thinking', tag2: 'AI Native', tag3: 'QTable', source: 'The canonical Markdown source lives in this repository. Syndicated copies on external engineering communities should point back here.',
  },
}[locale];
---
<BaseLayout locale={locale} route="blog/" title={copy.metaTitle} description={copy.metaDescription}>
  <section class="blog-index shell">
    <header class="blog-index-hero"><span class="blog-eyebrow">{copy.eyebrow}</span><h1>{copy.title}</h1><p>{copy.intro}</p></header>
    <div class="blog-section-head"><span>{copy.series}</span><span>01 / 10</span></div>
    <article class="article-card">
      <div class="article-number">01</div>
      <div class="article-copy"><div class="article-tags"><span>{copy.tag1}</span><span>{copy.tag2}</span><span>{copy.tag3}</span></div><h2>{copy.articleTitle}</h2><p>{copy.articleDescription}</p><div class="article-footer"><span>{copy.date}</span><a href={href('blog/why-qtable/')}>{copy.read} →</a></div></div>
    </article>
    <p class="canonical-note">{copy.source}</p>
  </section>
</BaseLayout>

<style>
  .blog-index{max-width:1080px;padding-top:86px;padding-bottom:110px}.blog-index-hero{max-width:900px;margin-bottom:70px}.blog-eyebrow{display:inline-block;margin-bottom:18px;font-size:.82rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase;color:#6ea8ff}.blog-index-hero h1{margin:0;font-size:clamp(2.4rem,5.7vw,5rem);line-height:1.03;letter-spacing:-.045em}.blog-index-hero p{max-width:820px;margin:24px 0 0;font-size:1.12rem;line-height:1.8;color:var(--text-muted)}.blog-section-head{display:flex;justify-content:space-between;gap:20px;margin-bottom:18px;padding-bottom:12px;border-bottom:1px solid var(--border);font-size:.84rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--text-muted)}.article-card{display:grid;grid-template-columns:92px 1fr;gap:28px;padding:34px;border:1px solid var(--border);border-radius:22px;background:rgba(255,255,255,.035);transition:transform .2s ease,border-color .2s ease}.article-card:hover{transform:translateY(-2px);border-color:rgba(110,168,255,.55)}.article-number{font-size:3.1rem;font-weight:800;line-height:1;color:rgba(110,168,255,.65)}.article-tags{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}.article-tags span{padding:5px 9px;border:1px solid var(--border);border-radius:999px;font-size:.76rem;color:var(--text-muted)}.article-copy h2{max-width:790px;margin:0;font-size:clamp(1.7rem,3vw,2.6rem);line-height:1.22;letter-spacing:-.025em}.article-copy p{max-width:760px;margin:16px 0 0;line-height:1.75;color:var(--text-muted)}.article-footer{display:flex;justify-content:space-between;gap:20px;align-items:center;margin-top:28px;font-size:.92rem;color:var(--text-muted)}.article-footer a{font-weight:700;color:#6ea8ff;text-decoration:none}.canonical-note{max-width:760px;margin:26px 0 0;font-size:.86rem;line-height:1.7;color:var(--text-muted)}@media(max-width:700px){.blog-index{padding-top:52px}.article-card{grid-template-columns:1fr;padding:24px}.article-number{font-size:2rem}.article-footer{align-items:flex-start;flex-direction:column}}
</style>
