      {copy.articles.map((article) => (
        <article class="article-card">
          <div class="article-number">{article.number}</div>
          <div class="article-copy">
            <div class="article-tags">{article.tags.map((tag) => <span>{tag}</span>)}</div>
            <h2>{article.title}</h2>
            <p>{article.description}</p>
            <div class="article-footer"><span>{article.date}</span><a href={articleHref(article.path)}>{copy.read} →</a></div>
          </div>
        </article>
      ))}
    </div>
    <p class="canonical-note">{copy.source}</p>
  </section>
</BaseLayout>

