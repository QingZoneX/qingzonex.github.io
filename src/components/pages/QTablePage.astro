---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableTour from '../TableTour.astro';
import { QTABLE_GITHUB_URL, QTABLE_UI_GITHUB_URL } from '../../lib/site';
import { localePath } from '../../lib/i18n.mjs';
import { getPortalContent, type PortalLocale } from '../../lib/portal-content';
interface Props { locale: PortalLocale }
const { locale }=Astro.props; const c=getPortalContent(locale).qtable; const href=(p='')=>localePath(locale,p,import.meta.env.BASE_URL);
---
<BaseLayout locale={locale} route="qtable/" title={c.metaTitle} description={c.metaDescription}>
<section class="product-hero"><div class="shell product-hero-grid"><div class="product-hero-copy"><span class="eyebrow"><i class="eyebrow-dot"></i>{c.eyebrow}</span><h1>{c.heroA}<br/><span class="gradient-text">{c.heroB}</span></h1><p>{c.heroCopy}</p><div class="page-actions"><a class="button primary" href={href('docs/qtable/overview/')}>{c.readDocs} →</a><a class="button secondary" href={QTABLE_GITHUB_URL}>{c.source}</a><a class="button ghost" href={QTABLE_UI_GITHUB_URL}>{c.frontendSource}</a></div></div><aside class="system-card" aria-label="QTable system architecture"><div class="system-card-head"><strong>QTable</strong><span>v0.1.0-alpha</span></div><div class="system-layer system-layer-web"><small>Frontend implementation</small><strong>QTable Web App</strong><span>React 19 · TypeScript · VTable · Apollo</span></div><div class="system-connector"><i></i><span>REST · GraphQL · WebSocket · OAuth</span><i></i></div><div class="system-layer system-layer-api"><small>Backend implementation</small><strong>QTable API & Services</strong><span>FastAPI · Strawberry GraphQL · Permission · Automation · AI</span></div><div class="system-foundation"><span>PostgreSQL</span><span>Redis</span><span>S3-compatible</span></div></aside></div><div class="shell product-metrics">{c.metrics.map(([a,b])=><div class="metric-card"><strong>{a}</strong><span>{b}</span></div>)}</div></section>
<section class="section"><div class="shell"><div class="section-head"><span class="kicker">{c.layers.kicker}</span><h2>{c.layers.title}</h2><p>{c.layers.description}</p></div><div class="implementation-grid-v2"><article id="frontend" class="implementation-card frontend-card"><div class="implementation-card-top"><span class="layer-mark">WEB</span><span class="implementation-tag">{c.layers.frontendTag}</span></div><h3>{c.layers.frontendTitle}</h3><p>{c.layers.frontendCopy}</p><ul>{c.layers.frontendItems.map((x)=><li>{x}</li>)}</ul><a class="text-link" href={QTABLE_UI_GITHUB_URL}>{c.frontendSource} ↗</a></article><article id="backend" class="implementation-card backend-card"><div class="implementation-card-top"><span class="layer-mark">API</span><span class="implementation-tag">{c.layers.backendTag}</span></div><h3>{c.layers.backendTitle}</h3><p>{c.layers.backendCopy}</p><ul>{c.layers.backendItems.map((x)=><li>{x}</li>)}</ul><a class="text-link" href={QTABLE_GITHUB_URL}>{c.source} ↗</a></article></div><div class="contract-pill"><span>{c.layers.contract}</span></div></div></section>
<section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">{c.core.kicker}</span><h2>{c.core.title}</h2><p>{c.core.description}</p></div><div class="feature-grid">{c.core.features.map(([icon,title,d])=><article class="feature-card"><div class="feature-icon">{icon}</div><h3>{title}</h3><p>{d}</p></article>)}</div></div></section>
<section class="section"><div class="shell"><div class="section-head section-head-row"><div><span class="kicker">{c.frontend.kicker}</span><h2>{c.frontend.title}</h2><p>{c.frontend.description}</p></div><div class="stack-cloud">{c.frontend.stack.map((x)=><span>{x}</span>)}</div></div><TableTour compact locale={locale}/></div></section>
<section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">{c.ai.kicker}</span><h2>{c.ai.title}</h2><p>{c.ai.description}</p></div><div class="feature-grid">{c.ai.features.map(([icon,title,d])=><article class="feature-card ai-card"><div class="feature-icon">{icon}</div><h3>{title}</h3><p>{d}</p></article>)}</div></div></section>
<section class="section"><div class="shell"><div class="section-head"><span class="kicker">{c.trust.kicker}</span><h2>{c.trust.title}</h2><p>{c.trust.description}</p></div><div class="trust-grid"><article class="trust-card"><div class="trust-icon">◎</div><h3>{c.trust.leftTitle}</h3><ul>{c.trust.leftItems.map((x)=><li>{x}</li>)}</ul></article><article class="trust-card"><div class="trust-icon">⬡</div><h3>{c.trust.rightTitle}</h3><ul>{c.trust.rightItems.map((x)=><li>{x}</li>)}</ul></article></div></div></section>
<section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">{c.hosting.kicker}</span><h2>{c.hosting.title}</h2><p>{c.hosting.description}</p></div><div class="architecture architecture-v2"><div class="arch-box primary"><strong>QTable Web App</strong><span>Nginx · PORT 9100</span></div><div class="arch-arrow">↓ API / GraphQL / WebSocket ↓</div><div class="arch-box primary"><strong>QTable API</strong><span>FastAPI · PORT 9000</span></div><div class="arch-row"><div class="arch-box"><strong>PostgreSQL 16</strong><span>{c.hosting.recommended}</span></div><div class="arch-box"><strong>Redis 7</strong><span>{c.hosting.runtime}</span></div></div><div class="arch-row"><div class="arch-box"><strong>MinIO / external S3</strong><span>{c.hosting.objects}</span></div><div class="arch-box"><strong>SQLite</strong><span>{c.hosting.fallback}</span></div></div></div></div></section>
<section class="cta"><div class="shell"><div class="cta-card"><h2>{c.cta.title}</h2><p>{c.cta.description}</p><div class="hero-actions"><a class="button primary" href={href('docs/getting-started/quick-start/')}>{c.cta.quick} →</a><a class="button secondary" href={href('docs/project/feature-matrix/')}>{c.cta.matrix}</a><a class="button ghost" href={href('docs/qtable/security/')}>{c.cta.security}</a></div></div></div></section>
</BaseLayout>
