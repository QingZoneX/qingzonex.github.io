---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { QTABLE_GITHUB_URL } from '../../lib/site';
import { localePath } from '../../lib/i18n.mjs';
import { getPortalContent, type PortalLocale } from '../../lib/portal-content';
interface Props { locale: PortalLocale }
const { locale } = Astro.props; const c = getPortalContent(locale).qtable; const href = (p='') => localePath(locale,p,import.meta.env.BASE_URL);
---
<BaseLayout locale={locale} route="qtable/" title={c.metaTitle} description={c.metaDescription}>
<section class="page-hero"><div class="shell"><span class="eyebrow"><i class="eyebrow-dot"></i>{c.eyebrow}</span><h1>{c.heroA}<br/>{c.heroB}</h1><p>{c.heroCopy}</p><div class="page-actions"><a class="button primary" href={href('docs/qtable/overview/')}>{c.readDocs} →</a><a class="button secondary" href={QTABLE_GITHUB_URL}>{c.source}</a></div><div class="stats">{c.stats.map(([a,b])=><div class="stat"><strong>{a}</strong><span>{b}</span></div>)}</div></div></section>
<section class="section"><div class="shell"><div class="section-head"><span class="kicker">{c.core.kicker}</span><h2>{c.core.title}</h2><p>{c.core.description}</p></div><div class="feature-grid">{c.core.features.map(([icon,title,d])=><article class="feature-card"><div class="feature-icon">{icon}</div><h3>{title}</h3><p>{d}</p></article>)}</div></div></section>
<section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">{c.ai.kicker}</span><h2>{c.ai.title}</h2><p>{c.ai.description}</p></div><div class="feature-grid">{c.ai.features.map(([icon,title,d])=><article class="feature-card"><div class="feature-icon">{icon}</div><h3>{title}</h3><p>{d}</p></article>)}</div></div></section>
<section class="section"><div class="shell"><div class="section-head"><span class="kicker">{c.attachments.kicker}</span><h2>{c.attachments.title}</h2><p>{c.attachments.description}</p></div><div class="two-col"><article class="product-card"><h3>{c.attachments.persisted}</h3><ul>{c.attachments.persistedItems.map(x=><li>{x}</li>)}</ul></article><article class="product-card ui"><h3>{c.attachments.runtime}</h3><ul>{c.attachments.runtimeItems.map(x=><li>{x}</li>)}</ul></article></div></div></section>
<section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">{c.safety.kicker}</span><h2>{c.safety.title}</h2><p>{c.safety.description}</p></div><div class="flow">{c.safety.steps.map(([a,b])=><div class="flow-step"><b>{a}</b><span>{b}</span></div>)}</div></div></section>
<section class="section"><div class="shell"><div class="section-head"><span class="kicker">{c.hosting.kicker}</span><h2>{c.hosting.title}</h2><p>{c.hosting.description}</p></div><div class="architecture"><div class="arch-box primary"><strong>QTable API</strong><span>FastAPI + Strawberry GraphQL</span></div><div class="arch-arrow">↓</div><div class="arch-row"><div class="arch-box"><strong>PostgreSQL 16</strong><span>{c.hosting.recommended}</span></div><div class="arch-box"><strong>Redis 7</strong><span>{c.hosting.runtime}</span></div></div><div class="arch-row"><div class="arch-box"><strong>MinIO / external S3</strong><span>{c.hosting.objects}</span></div><div class="arch-box"><strong>SQLite</strong><span>{c.hosting.fallback}</span></div></div></div></div></section>
<section class="cta"><div class="shell"><div class="cta-card"><h2>{c.cta.title}</h2><p>{c.cta.description}</p><div class="hero-actions"><a class="button primary" href={href('docs/getting-started/quick-start/')}>{c.cta.quick} →</a><a class="button secondary" href={href('docs/project/feature-matrix/')}>{c.cta.matrix}</a><a class="button ghost" href={href('docs/qtable/security/')}>{c.cta.security}</a></div></div></div></section>
</BaseLayout>
