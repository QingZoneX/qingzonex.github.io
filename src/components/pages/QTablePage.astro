---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableTour from '../TableTour.astro';
import Icon from '../Icon.astro';
import { QTABLE_GITHUB_URL, QTABLE_UI_GITHUB_URL } from '../../lib/site';
import { localePath } from '../../lib/i18n.mjs';
import { getPortalContent, type PortalLocale } from '../../lib/portal-content';
interface Props { locale: PortalLocale }
const { locale }=Astro.props; const c=getPortalContent(locale).qtable; const href=(p='')=>localePath(locale,p,import.meta.env.BASE_URL);
const layerLabels = {
  'zh-cn': { web: 'Web 前端实现', api: 'API 与领域服务', data:'数据与存储' },
  'zh-tw': { web: 'Web 前端實作', api: 'API 與領域服務', data:'資料與儲存' },
  en: { web: 'Web frontend implementation', api: 'API & domain services', data:'Data & storage' },
}[locale];
const focusCopy = {
  'zh-cn': { hero:'QTable 将 Web 应用、API 与领域服务统一在同一数据模型、权限边界和发布节奏中，形成从界面到底层服务完整可自托管工作系统。', frontendTitle:'QTable Web 体验承载完整产品交互。', ctaTitle:'启动完整 QTable。' },
  'zh-tw': { hero:'QTable 將 Web 應用程式、API 與領域服務統一在同一資料模型、權限邊界與發佈節奏中，形成從介面到底層服務的完整自託管工作系統。', frontendTitle:'QTable Web 體驗承載完整產品互動。', ctaTitle:'啟動完整 QTable。' },
  en: { hero:'QTable unifies the web application, API and domain services around one data model, permission boundary and release cadence to form a complete self-hostable work system.', frontendTitle:'The QTable web experience carries the complete product interaction model.', ctaTitle:'Launch the complete QTable stack.' },
}[locale];
---
<BaseLayout locale={locale} route="qtable/" title={c.metaTitle} description={c.metaDescription}>
<section class="product-hero"><div class="shell product-hero-grid"><div class="product-hero-copy"><span class="eyebrow"><i class="eyebrow-dot"></i>{c.eyebrow}</span><h1>{c.heroA}<br/><span class="gradient-text">{c.heroB}</span></h1><p>{focusCopy.hero}</p><div class="page-actions"><a class="button primary" href={href('docs/qtable/overview/')}>{c.readDocs} →</a><a class="button secondary" href={QTABLE_GITHUB_URL}>{c.source}</a><a class="button ghost" href={QTABLE_UI_GITHUB_URL}>{c.frontendSource}</a></div></div><aside class="system-card" aria-label="QTable system architecture"><div class="system-card-head"><strong>QTable</strong><span>v0.1.0-alpha</span></div><div class="system-layer system-layer-web"><small>{layerLabels.web}</small><strong>QTable Web App</strong><span>React 19 · TypeScript · VTable · Apollo</span></div><div class="system-connector"><i></i><span>REST · GraphQL · WebSocket · OAuth</span><i></i></div><div class="system-layer system-layer-api"><small>{layerLabels.api}</small><strong>QTable API & Services</strong><span>FastAPI · Strawberry GraphQL · Permission · Automation · AI</span></div><div class="system-foundation"><span>PostgreSQL</span><span>Redis</span><span>S3-compatible</span></div></aside></div><div class="shell product-metrics">{c.metrics.map(([a,b])=><div class="metric-card"><strong>{a}</strong><span>{b}</span></div>)}</div></section>
<section class="section"><div class="shell"><div class="section-head"><span class="kicker">{c.layers.kicker}</span><h2>{c.layers.title}</h2><p>{c.layers.description}</p></div><div class="implementation-grid-v2"><article id="frontend" class="implementation-card frontend-card"><div class="implementation-card-top"><span class="layer-mark">WEB</span><span class="implementation-tag">{layerLabels.web}</span></div><h3>{c.layers.frontendTitle}</h3><p>{c.layers.frontendCopy}</p><ul>{c.layers.frontendItems.map((x)=><li>{x}</li>)}</ul><a class="text-link" href={QTABLE_UI_GITHUB_URL}>{c.frontendSource} ↗</a></article><article id="backend" class="implementation-card backend-card"><div class="implementation-card-top"><span class="layer-mark">API</span><span class="implementation-tag">{layerLabels.api}</span></div><h3>{c.layers.backendTitle}</h3><p>{c.layers.backendCopy}</p><ul>{c.layers.backendItems.map((x)=><li>{x}</li>)}</ul><a class="text-link" href={QTABLE_GITHUB_URL}>{c.source} ↗</a></article></div><div class="contract-pill"><span>{c.layers.contract}</span></div></div></section>
<section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">{c.core.kicker}</span><h2>{c.core.title}</h2><p>{c.core.description}</p></div><div class="capability-cards">{c.core.features.map(([icon,title,d])=><article class="capability-card"><div class="capability-icon"><Icon name={icon} size={21}/></div><h3>{title}</h3><p>{d}</p></article>)}</div></div></section>
<section class="section"><div class="shell"><div class="section-head section-head-row"><div><span class="kicker">{c.frontend.kicker}</span><h2>{focusCopy.frontendTitle}</h2><p>{c.frontend.description}</p></div><div class="stack-cloud">{c.frontend.stack.map((x)=><span>{x}</span>)}</div></div><TableTour compact locale={locale}/></div></section>
<section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">{c.ai.kicker}</span><h2>{c.ai.title}</h2><p>{c.ai.description}</p></div><div class="capability-cards">{c.ai.features.map(([icon,title,d],i)=><article class="capability-card"><div class="capability-icon feature-step">{icon}</div><h3>{title}</h3><p>{d}</p></article>)}</div></div></section>
<section class="section"><div class="shell"><div class="section-head"><span class="kicker">{c.trust.kicker}</span><h2>{c.trust.title}</h2><p>{c.trust.description}</p></div><div class="trust-grid"><article class="trust-card"><div class="trust-icon"><Icon name="shield" size={20}/></div><h3>{c.trust.leftTitle}</h3><ul>{c.trust.leftItems.map((x)=><li>{x}</li>)}</ul></article><article class="trust-card"><div class="trust-icon"><Icon name="box" size={20}/></div><h3>{c.trust.rightTitle}</h3><ul>{c.trust.rightItems.map((x)=><li>{x}</li>)}</ul></article></div></div></section>
<section class="architecture-showcase"><div class="shell architecture-layout"><div class="architecture-copy"><span class="kicker">{c.hosting.kicker}</span><h2>{c.hosting.title}</h2><p>{c.hosting.description}</p><a class="button secondary" href={href('docs/getting-started/self-hosting/')}>{c.cta.quick} →</a></div><div class="arch-pipeline"><article class="arch-stage"><div class="arch-stage-head"><div class="arch-stage-icon"><Icon name="dashboard" size={20}/></div><div><h3>QTable Web App</h3><p>Nginx · PORT 9100</p></div></div><div class="arch-stage-list"><span>React 19 + TypeScript</span><span>VTable + Apollo</span><span>{layerLabels.web}</span></div></article><div class="arch-connector">↔</div><article class="arch-stage"><div class="arch-stage-head"><div class="arch-stage-icon"><Icon name="automation" size={20}/></div><div><h3>QTable API</h3><p>FastAPI · PORT 9000</p></div></div><div class="arch-stage-list"><span>GraphQL · REST</span><span>WebSocket · OAuth</span><span>Permission · Automation · AI</span></div></article><div class="arch-connector">↔</div><article class="arch-stage"><div class="arch-stage-head"><div class="arch-stage-icon"><Icon name="box" size={20}/></div><div><h3>{layerLabels.data}</h3><p>{c.hosting.recommended}</p></div></div><div class="arch-stage-list"><span>PostgreSQL 16</span><span>Redis 7</span><span>MinIO / external S3</span><span>SQLite fallback</span></div></article></div></div></section>
<section class="cta"><div class="shell"><div class="cta-card"><h2>{focusCopy.ctaTitle}</h2><p>{c.cta.description}</p><div class="hero-actions"><a class="button primary" href={href('docs/getting-started/quick-start/')}>{c.cta.quick} →</a><a class="button secondary" href={href('docs/project/feature-matrix/')}>{c.cta.matrix}</a><a class="button ghost" href={href('docs/qtable/security/')}>{c.cta.security}</a></div></div></div></section>
</BaseLayout>
