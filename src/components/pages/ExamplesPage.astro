---
import BaseLayout from '../../layouts/BaseLayout.astro'; import TableTour from '../TableTour.astro'; import { localePath } from '../../lib/i18n.mjs'; import { getPortalContent, type PortalLocale } from '../../lib/portal-content';
interface Props { locale: PortalLocale } const { locale }=Astro.props; const c=getPortalContent(locale).examples; const href=(p='')=>localePath(locale,p,import.meta.env.BASE_URL);
---
<BaseLayout locale={locale} route="examples/" title={c.metaTitle} description={c.metaDescription}>
<section class="page-hero page-hero-v2"><div class="shell"><span class="eyebrow"><i class="eyebrow-dot"></i>{c.eyebrow}</span><h1>{c.title}</h1><p>{c.description}</p></div></section>
<section class="section section-tight"><div class="shell"><div class="notice demo-notice"><strong>{c.boundaryTitle}</strong> {c.boundary}</div><TableTour locale={locale}/></div></section>
<section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">{c.scenarioKicker}</span><h2>{c.scenarioTitle}</h2></div><div class="scenario-grid">{c.scenarios.map(([title,d],i)=><article class="scenario-card"><span class="scenario-index">0{i+1}</span><h3>{title}</h3><p>{d}</p></article>)}</div></div></section>
<section class="section"><div class="shell"><div class="section-head"><span class="kicker">{c.realKicker}</span><h2>{c.realTitle}</h2><p>{c.realDescription}</p></div><div class="page-actions"><a class="button primary" href={href('docs/getting-started/self-hosting/')}>{c.selfHosting} →</a><a class="button secondary" href={href('docs/getting-started/quick-start/')}>{c.quick}</a></div></div></section>
</BaseLayout>
