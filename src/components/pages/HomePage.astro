---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableTour from '../TableTour.astro';
import Icon from '../Icon.astro';
import { QTABLE_GITHUB_URL } from '../../lib/site';
import { localePath } from '../../lib/i18n.mjs';
import { getPortalContent, type PortalLocale } from '../../lib/portal-content';
interface Props { locale: PortalLocale }
const { locale }=Astro.props; const c=getPortalContent(locale).home; const href=(p='')=>localePath(locale,p,import.meta.env.BASE_URL);
const layerLabels = {
  'zh-cn': { web: 'Web 前端实现', api: 'API 与领域服务' },
  'zh-tw': { web: 'Web 前端實作', api: 'API 與領域服務' },
  en: { web: 'Web frontend implementation', api: 'API & domain services' },
}[locale];
const focusCopy = {
  'zh-cn': {
    baseline: '当前 Alpha 已覆盖从个人工作、项目执行到自动化、协作与分析的主要工作面，所有能力共享同一套结构化数据模型。',
    foundation: 'QTable 的 Web 前端与 API / 领域服务按职责分层实现，并共享同一产品模型、权限边界和发布基线。',
  },
  'zh-tw': {
    baseline: '目前 Alpha 已涵蓋從個人工作、專案執行到自動化、協作與分析的主要工作面，所有能力共用同一套結構化資料模型。',
    foundation: 'QTable 的 Web 前端與 API / 領域服務依職責分層實作，並共用同一產品模型、權限邊界與發佈基線。',
  },
  en: {
    baseline: 'The current Alpha covers the major work surfaces from personal work and project execution to automation, collaboration and analysis, all on one structured data model.',
    foundation: 'QTable separates the web frontend and API / domain services by engineering responsibility while keeping one product model, permission boundary and release baseline.',
  },
}[locale];
const focused = (value: string) => {
  if (locale === 'zh-cn') return value.replaceAll('QNote/Clipper', '来源接入').replaceAll('QTableUI', '前端实现');
  if (locale === 'zh-tw') return value.replaceAll('QNote/Clipper', '來源接入').replaceAll('QTableUI', '前端實作');
  return value.replaceAll('QNote/Clipper', 'source intake').replaceAll('QTableUI', 'frontend implementation');
};
---
<BaseLayout locale={locale} route="" title={c.metaTitle} description={c.metaDescription}>
<section class="hero hero-v2"><div class="shell hero-grid"><div class="hero-copy-block"><span class="eyebrow"><i class="eyebrow-dot"></i>{c.eyebrow}</span><h1>{c.heroA} <span class="gradient">{c.heroB}</span></h1><p class="hero-copy">{c.heroCopy}</p><div class="hero-actions"><a class="button primary" href={href('qtable/')}>{c.explore} <span aria-hidden="true">→</span></a><a class="button secondary" href={href('docs/getting-started/quick-start/')}>{c.getStarted}</a><a class="button ghost" href={QTABLE_GITHUB_URL}>{c.viewGithub}</a></div><div class="hero-meta"><span>Apache-2.0</span><span>Self-hostable</span><span>AI optional</span><span>Permission-aware</span><span>v0.1.0-alpha</span></div></div><div class="product-window" aria-label="QTable product preview"><div class="window-bar"><i class="window-dot"></i><i class="window-dot"></i><i class="window-dot"></i><span class="window-title">{c.window.title}</span></div><div class="app-shell"><aside class="app-sidebar"><div class="side-item active"><i class="side-dot"></i>{c.window.home}</div><div class="side-item"><i class="side-dot"></i>{c.window.projects}</div><div class="side-item"><i class="side-dot"></i>{c.window.dashboards}</div><div class="side-item"><i class="side-dot"></i>{c.window.automations}</div><div class="side-item"><i class="side-dot"></i>{c.window.ai}</div></aside><div class="app-main"><div class="app-toolbar"><strong>{c.window.launch}</strong><span>{c.window.myWork}</span></div><div class="view-tabs"><span class="active">Grid</span><span>Kanban</span><span>Gantt</span><span>Calendar</span><span>Gallery</span></div><div class="mini-table"><div class="mini-row header"><span>{c.window.task}</span><span>{c.window.status}</span><span>{c.window.owner}</span><span>{c.window.priority}</span></div>{c.window.rows.map((row,i)=><div class="mini-row"><span>{row[0]}</span><span><i class:list={['status-chip',{blue:i===1,amber:i===2}]}>{row[1]}</i></span><span><span class="avatar-stack"><i></i>{i%2===0&&<i></i>}</span></span><span>{row[2]}</span></div>)}</div></div></div></div></div></section>
<section class="logo-strip"><div class="shell">{['React 19','TypeScript 6','VTable','FastAPI','Strawberry GraphQL','PostgreSQL','Redis','S3-compatible','Apollo Client','VChart'].map((item)=><span class="tech-chip">{item}</span>)}</div></section>
<section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">{c.baseline.kicker}</span><h2>{c.baseline.title}</h2><p>{focusCopy.baseline}</p></div><div class="feature-grid">{c.baseline.features.map(([icon,title,d],i)=><article class={`feature-card feature-tone-${i%3}`}><div class="feature-icon"><Icon name={icon} size={22}/></div><h3>{title}</h3><p>{focused(d)}</p></article>)}</div></div></section>
<section class="section"><div class="shell"><div class="section-head"><span class="kicker">{c.foundation.kicker}</span><h2>{c.foundation.title}</h2><p>{focusCopy.foundation}</p></div><article class="unified-product-card"><div class="implementation-layer frontend-layer"><div class="layer-mark">WEB</div><div><span class="implementation-tag">{layerLabels.web}</span><h3>{c.foundation.frontendTitle}</h3><p>{focused(c.foundation.frontendCopy)}</p></div></div><div class="implementation-bridge"><span>{c.foundation.contract}</span></div><div class="implementation-layer backend-layer"><div class="layer-mark">API</div><div><span class="implementation-tag">{layerLabels.api}</span><h3>{c.foundation.backendTitle}</h3><p>{c.foundation.backendCopy}</p></div></div><div class="unified-product-footer"><strong>QTable</strong><span>{c.foundation.contract}</span><a class="button small" href={href('qtable/')}>{c.foundation.productLink} →</a></div></article></div></section>
<section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">{c.productModel.kicker}</span><h2>{c.productModel.title}</h2><p>{c.productModel.description}</p></div><TableTour locale={locale}/></div></section>
<section class="section"><div class="shell"><div class="section-head"><span class="kicker">{c.aiFlow.kicker}</span><h2>{c.aiFlow.title}</h2><p>{c.aiFlow.description}</p></div><div class="flow">{c.aiFlow.steps.map(([title,d])=><div class="flow-step"><b>{title}</b><span>{d}</span></div>)}</div></div></section>
<section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">{c.architecture.kicker}</span><h2>{c.architecture.title}</h2><p>{c.architecture.description}</p></div><div class="architecture architecture-v2"><div class="arch-box primary"><strong>QTable Web App</strong><span>React + TypeScript + VTable + Apollo</span></div><div class="arch-arrow">↓ REST / GraphQL / WebSocket ↓</div><div class="arch-box primary"><strong>QTable API</strong><span>FastAPI + Strawberry GraphQL</span></div><div class="arch-row"><div class="arch-box"><strong>PostgreSQL / SQLite</strong><span>{c.architecture.recommended}</span></div><div class="arch-box"><strong>Redis</strong><span>{c.architecture.runtime}</span></div></div><div class="arch-row"><div class="arch-box"><strong>Permission / ChangeSet / Automation / AI</strong><span>{c.architecture.appServices}</span></div><div class="arch-box"><strong>MinIO / S3-compatible</strong><span>{c.architecture.attachments}</span></div></div></div></div></section>
<section class="section"><div class="shell"><div class="section-head"><span class="kicker">{c.release.kicker}</span><h2>{c.release.title}</h2><p>{c.release.description}</p></div><div class="two-col"><article class="product-card"><h3>{c.release.matrixTitle}</h3><p>{c.release.matrixCopy}</p><a class="text-link" href={href('docs/project/feature-matrix/')}>{c.release.matrixLink} →</a></article><article class="product-card ui"><h3>{c.release.prodTitle}</h3><p>{c.release.prodCopy}</p><a class="text-link" href={href('docs/getting-started/production-checklist/')}>{c.release.prodLink} →</a></article></div></div></section>
<section class="cta"><div class="shell"><div class="cta-card"><h2>{c.cta.title}</h2><p>{c.cta.description}</p><div class="hero-actions"><a class="button primary" href={href('qtable/')}>{c.cta.product} →</a><a class="button secondary" href={href('docs/')}>{c.cta.docs}</a><a class="button ghost" href={QTABLE_GITHUB_URL}>{c.cta.source}</a></div></div></div></section>
</BaseLayout>
