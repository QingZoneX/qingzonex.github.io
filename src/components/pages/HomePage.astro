---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableTour from '../TableTour.astro';
import { QTABLE_GITHUB_URL, QTABLE_UI_GITHUB_URL } from '../../lib/site';
import { localePath } from '../../lib/i18n.mjs';
import { getPortalContent, type PortalLocale } from '../../lib/portal-content';
interface Props { locale: PortalLocale }
const { locale } = Astro.props;
const c = getPortalContent(locale).home;
const href = (path = '') => localePath(locale, path, import.meta.env.BASE_URL);
---
<BaseLayout locale={locale} route="" title={c.metaTitle} description={c.metaDescription}>
  <section class="hero"><div class="shell hero-grid"><div><span class="eyebrow"><i class="eyebrow-dot"></i>{c.eyebrow}</span><h1>{c.heroA} <span class="gradient">{c.heroB}</span></h1><p class="hero-copy">{c.heroCopy}</p><div class="hero-actions"><a class="button primary" href={href('docs/getting-started/quick-start/')}>{c.getStarted} <span aria-hidden="true">→</span></a><a class="button secondary" href={QTABLE_GITHUB_URL}>{c.viewGithub}</a></div><div class="hero-meta"><span>Apache-2.0</span><span>Self-hostable</span><span>AI optional</span><span>Permission-aware</span><span>v0.1.0-alpha</span></div></div>
  <div class="product-window" aria-label="QTable product preview"><div class="window-bar"><i class="window-dot"></i><i class="window-dot"></i><i class="window-dot"></i><span class="window-title">{c.window.title}</span></div><div class="app-shell"><aside class="app-sidebar"><div class="side-item active"><i class="side-dot"></i>{c.window.home}</div><div class="side-item"><i class="side-dot"></i>{c.window.projects}</div><div class="side-item"><i class="side-dot"></i>{c.window.dashboards}</div><div class="side-item"><i class="side-dot"></i>{c.window.automations}</div><div class="side-item"><i class="side-dot"></i>{c.window.ai}</div></aside><div class="app-main"><div class="app-toolbar"><strong>{c.window.launch}</strong><span>{c.window.myWork}</span></div><div class="view-tabs"><span class="active">Grid</span><span>Kanban</span><span>Gantt</span><span>Calendar</span><span>Gallery</span></div><div class="mini-table"><div class="mini-row header"><span>{c.window.task}</span><span>{c.window.status}</span><span>{c.window.owner}</span><span>{c.window.priority}</span></div>{c.window.rows.map((row, i) => <div class="mini-row"><span>{row[0]}</span><span><i class:list={['status-chip', { blue: i === 1, amber: i === 2 }]}>{row[1]}</i></span><span><span class="avatar-stack"><i></i>{i % 2 === 0 && <i></i>}</span></span><span>{row[2]}</span></div>)}</div></div></div></div></div></section>
  <section class="logo-strip" aria-label="Technology stack"><div class="shell">{['FastAPI','Strawberry GraphQL','PostgreSQL','Redis','S3-compatible','React 19','TypeScript 6','VTable','Apollo Client','VChart'].map((item) => <span class="tech-chip">{item}</span>)}</div></section>
  <section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">{c.baseline.kicker}</span><h2>{c.baseline.title}</h2><p>{c.baseline.description}</p></div><div class="feature-grid">{c.baseline.features.map(([icon,title,description]) => <article class="feature-card"><div class="feature-icon">{icon}</div><h3>{title}</h3><p>{description}</p></article>)}</div></div></section>
  <section class="section"><div class="shell"><div class="section-head"><span class="kicker">{c.foundation.kicker}</span><h2>{c.foundation.title}</h2><p>{c.foundation.description}</p></div><div class="two-col"><article class="product-card"><span class="eyebrow">Backend · v0.1.0-alpha</span><h3>QTable</h3><p>{c.foundation.qtable}</p><ul>{c.foundation.qtableBullets.map((x) => <li>{x}</li>)}</ul><a class="text-link" href={href('qtable/')}>{c.foundation.explore} QTable <span>→</span></a></article><article class="product-card ui"><span class="eyebrow">Frontend · v0.1.0-alpha</span><h3>QTableUI</h3><p>{c.foundation.qtableui}</p><ul>{c.foundation.uiBullets.map((x) => <li>{x}</li>)}</ul><a class="text-link" href={href('qtable-ui/')}>{c.foundation.explore} QTableUI <span>→</span></a></article></div></div></section>
  <section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">{c.productModel.kicker}</span><h2>{c.productModel.title}</h2><p>{c.productModel.description}</p></div><TableTour locale={locale} /></div></section>
  <section class="section"><div class="shell"><div class="section-head"><span class="kicker">{c.aiFlow.kicker}</span><h2>{c.aiFlow.title}</h2><p>{c.aiFlow.description}</p></div><div class="flow">{c.aiFlow.steps.map(([title,description]) => <div class="flow-step"><b>{title}</b><span>{description}</span></div>)}</div></div></section>
  <section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">{c.architecture.kicker}</span><h2>{c.architecture.title}</h2><p>{c.architecture.description}</p></div><div class="architecture"><div class="arch-box primary"><strong>QTableUI</strong><span>React + TypeScript + VTable + Apollo</span></div><div class="arch-arrow">↓ HTTP / GraphQL / WebSocket ↓</div><div class="arch-box primary"><strong>QTable API</strong><span>FastAPI + Strawberry GraphQL</span></div><div class="arch-arrow">↓</div><div class="arch-row"><div class="arch-box"><strong>PostgreSQL / SQLite</strong><span>{c.architecture.recommended}</span></div><div class="arch-box"><strong>Redis</strong><span>{c.architecture.runtime}</span></div></div><div class="arch-row"><div class="arch-box"><strong>Permission / ChangeSet / AI</strong><span>{c.architecture.appServices}</span></div><div class="arch-box"><strong>MinIO / S3-compatible</strong><span>{c.architecture.attachments}</span></div></div></div></div></section>
  <section class="section"><div class="shell"><div class="section-head"><span class="kicker">{c.release.kicker}</span><h2>{c.release.title}</h2><p>{c.release.description}</p></div><div class="two-col"><article class="product-card"><h3>{c.release.matrixTitle}</h3><p>{c.release.matrixCopy}</p><a class="text-link" href={href('docs/project/feature-matrix/')}>{c.release.matrixLink} →</a></article><article class="product-card ui"><h3>{c.release.prodTitle}</h3><p>{c.release.prodCopy}</p><a class="text-link" href={href('docs/getting-started/production-checklist/')}>{c.release.prodLink} →</a></article></div></div></section>
  <section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">{c.ecosystem.kicker}</span><h2>{c.ecosystem.title}</h2><p>{c.ecosystem.description}</p></div></div></section>
  <section class="cta"><div class="shell"><div class="cta-card"><h2>{c.cta.title}</h2><p>{c.cta.description}</p><div class="hero-actions"><a class="button primary" href={href('docs/')}>{c.cta.docs} →</a><a class="button secondary" href={QTABLE_GITHUB_URL}>{c.cta.qtable}</a><a class="button ghost" href={QTABLE_UI_GITHUB_URL}>{c.cta.ui}</a></div></div></div></section>
</BaseLayout>
