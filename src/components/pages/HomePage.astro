---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableTour from '../TableTour.astro';
import Icon from '../Icon.astro';
import { QTABLE_GITHUB_URL } from '../../lib/site';
import { localePath } from '../../lib/i18n.mjs';
import { getPortalContent, QTABLE_VERSION, type PortalLocale } from '../../lib/current-portal-content';
interface Props { locale: PortalLocale }
const { locale }=Astro.props; const c=getPortalContent(locale).home; const href=(p='')=>localePath(locale,p,import.meta.env.BASE_URL);
const copy = {
  'zh-cn': {
    note:'让数据驱动更好的工作', assistant:'AI 助手', assistantCopy:'理解你的数据，让工作更高效',
    baseline:'当前 Alpha 已覆盖个人工作、项目执行、自动化、协作、搜索与分析等主要工作面，全部建立在同一套结构化数据模型上。',
    foundation:'QTable 把 Web 前端、API / 领域服务与数据基础设施组织成一个完整产品，可自托管，也方便按工程边界扩展。', architectureAction:'了解架构设计',
    web:'现代 Web 体验', webCopy:'多视图、仪表盘、协作与 AI 交互', api:'API 与领域服务', apiCopy:'实时、自动化、权限、审计与 AI', data:'数据与存储', dataCopy:'可自托管的开源基础设施',
    views:'灵活的工作视图', ai:'AI 驱动的工作流', aiCopy:'AI 基于当前用户可见的数据与业务上下文工作，建议、预览和应用都遵守既有权限边界。',
    aiChecks:['基于数据的智能问答','项目风险与进展分析','任务拆解与执行建议'], aiQuestion:'分析这个项目的进展情况', aiResponse:'当前项目整体推进正常，建议优先关注进行中的高优先级任务，并在应用任何变更前检查权限与最新状态。', aiInput:'向 QTable AI 提问…',
  },
  'zh-tw': {
    note:'讓資料驅動更好的工作', assistant:'AI 助手', assistantCopy:'理解你的資料，讓工作更高效',
    baseline:'目前 Alpha 已涵蓋個人工作、專案執行、自動化、協作、搜尋與分析等主要工作面，全部建立在同一套結構化資料模型上。',
    foundation:'QTable 將 Web 前端、API / 領域服務與資料基礎設施組織成一個完整產品，可自託管，也方便依工程邊界擴充。', architectureAction:'了解架構設計',
    web:'現代 Web 體驗', webCopy:'多檢視、儀表板、協作與 AI 互動', api:'API 與領域服務', apiCopy:'即時、自動化、權限、稽核與 AI', data:'資料與儲存', dataCopy:'可自託管的開源基礎設施',
    views:'靈活的工作檢視', ai:'AI 驅動的工作流程', aiCopy:'AI 依目前使用者可見的資料與業務脈絡運作，建議、預覽與套用都遵守既有權限邊界。',
    aiChecks:['基於資料的智慧問答','專案風險與進度分析','任務拆解與執行建議'], aiQuestion:'分析這個專案的進展情況', aiResponse:'目前專案整體推進正常，建議優先關注進行中的高優先級任務，並在套用任何變更前檢查權限與最新狀態。', aiInput:'向 QTable AI 提問…',
  },
  en: {
    note:'Let data drive better work', assistant:'AI assistant', assistantCopy:'Understand your data and make work more effective',
    baseline:'The current Alpha covers the major work surfaces across personal work, project execution, automation, collaboration, search and analysis, all on one structured data model.',
    foundation:'QTable brings the web frontend, API / domain services and data infrastructure together as one self-hostable product with clear engineering boundaries.', architectureAction:'Explore the architecture',
    web:'Modern web experience', webCopy:'Multiple views, dashboards, collaboration and AI', api:'API & domain services', apiCopy:'Realtime, automation, permissions, audit and AI', data:'Data & storage', dataCopy:'Self-hostable open infrastructure',
    views:'Flexible work views', ai:'AI-driven workflows', aiCopy:'AI works from the data and business context the current user can see, while suggestions, previews and applies stay inside the existing permission boundary.',
    aiChecks:['Data-grounded Q&A','Project risk and progress analysis','Task breakdown and execution suggestions'], aiQuestion:'Analyze this project’s progress', aiResponse:'The project is progressing normally. Prioritize active high-priority tasks and re-check permissions and current state before applying any change.', aiInput:'Ask QTable AI…',
  },
  ar: {
    note:'اجعل البيانات تقود عملًا أفضل', assistant:'مساعد الذكاء الاصطناعي', assistantCopy:'افهم بياناتك واجعل العمل أكثر فاعلية',
    baseline:'تغطي نسخة Alpha الحالية أسطح العمل الرئيسية عبر العمل الفردي وتنفيذ المشاريع والأتمتة والتعاون والبحث والتحليل، وكلها فوق نموذج بيانات منظّم واحد.',
    foundation:'يجمع QTable الواجهة وخدمات API / النطاق وبنية البيانات التحتية في منتج واحد قابل للاستضافة الذاتية، يسهل توسيعه وفق الحدود الهندسية.', architectureAction:'استكشف المعمارية',
    web:'تجربة ويب حديثة', webCopy:'عروض متعددة ولوحات معلومات وتعاون وذكاء اصطناعي', api:'واجهة API وخدمات النطاق', apiCopy:'لحظية وأتمتة وصلاحيات وتدقيق وذكاء اصطناعي', data:'البيانات والتخزين', dataCopy:'بنية تحتية مفتوحة المصدر قابلة للاستضافة الذاتية',
    views:'عروض عمل مرنة', ai:'سير عمل مدفوع بالذكاء الاصطناعي', aiCopy:'يعمل الذكاء الاصطناعي انطلاقًا من البيانات وسياق العمل المرئي للمستخدم الحالي، بينما تلتزم الاقتراحات والمعاينة والتطبيق بحدود الصلاحيات الحالية.',
    aiChecks:['أسئلة وأجوبة قائمة على البيانات','تحليل مخاطر المشروع وتقدمه','تفكيك المهام واقتراحات التنفيذ'], aiQuestion:'حلّل تقدّم هذا المشروع', aiResponse:'المشروع يتقدم بشكل طبيعي. ننصح بالتركيز على المهام النشطة عالية الأولوية وإعادة فحص الصلاحيات والحالة قبل تطبيق أي تغيير.', aiInput:'اسأل ذكاء QTable…',
  },
  fr: {
    note:'Laissez les données guider un meilleur travail', assistant:'Assistant IA', assistantCopy:'Comprenez vos données et rendez le travail plus efficace',
    baseline:"L'Alpha actuelle couvre les principales surfaces de travail — travail personnel, exécution de projet, automatisation, collaboration, recherche et analyse — sur un même modèle de données structuré.",
    foundation:"QTable réunit le front web, les services API / domaine et l'infrastructure de données en un seul produit auto-hébergeable, facile à étendre selon les frontières d'ingénierie.", architectureAction:"Explorer l'architecture",
    web:'Expérience web moderne', webCopy:'Vues multiples, tableaux de bord, collaboration et IA', api:'API et services de domaine', apiCopy:'Temps réel, automatisation, permissions, audit et IA', data:'Données et stockage', dataCopy:'Infrastructure ouverte auto-hébergeable',
    views:'Vues de travail flexibles', ai:'Workflows pilotés par IA', aiCopy:"L'IA travaille à partir des données et du contexte métier visibles par l'utilisateur courant ; suggestions, aperçus et applications restent dans la frontière de permission existante.",
    aiChecks:['Questions-réponses ancrées dans les données','Analyse des risques et de l\'avancement du projet','Décomposition des tâches et suggestions d\'exécution'], aiQuestion:'Analyser l\'avancement de ce projet', aiResponse:"Le projet progresse normalement. Priorisez les tâches actives à haute priorité et revérifiez les permissions et l'état avant toute modification.", aiInput:'Poser une question à QTable AI…',
  },
  ru: {
    note:'Пусть данные ведут к лучшей работе', assistant:'ИИ-ассистент', assistantCopy:'Понимайте данные и делайте работу эффективнее',
    baseline:'Текущая Alpha охватывает основные рабочие поверхности — личную работу, выполнение проектов, автоматизацию, совместную работу, поиск и анализ — на одной структурированной модели данных.',
    foundation:'QTable объединяет веб-интерфейс, API / доменные сервисы и инфраструктуру данных в один самодостаточный продукт, который легко расширять по инженерным границам.', architectureAction:'Изучить архитектуру',
    web:'Современный веб-интерфейс', webCopy:'Несколько представлений, дашборды, совместная работа и ИИ', api:'API и доменные сервисы', apiCopy:'Реальное время, автоматизация, права, аудит и ИИ', data:'Данные и хранилище', dataCopy:'Самодостаточная открытая инфраструктура',
    views:'Гибкие представления работы', ai:'ИИ-процессы', aiCopy:'ИИ работает на основе данных и делового контекста, видимых текущему пользователю; предложения, предпросмотр и применение остаются в границах прав.',
    aiChecks:['Ответы на вопросы на основе данных','Анализ рисков и прогресса проекта','Декомпозиция задач и предложения по выполнению'], aiQuestion:'Проанализируй прогресс этого проекта', aiResponse:'Проект развивается нормально. Сосредоточьтесь на активных высокоприоритетных задачах и заново проверьте права и состояние перед применением изменений.', aiInput:'Спросить QTable AI…',
  },
  ja: {
    note:'データでより良い仕事を', assistant:'AI アシスタント', assistantCopy:'データを理解し、仕事をより効率的に',
    baseline:'現在の Alpha は個人の作業・プロジェクト遂行・自動化・コラボレーション・検索・分析という主要な作業面を、単一の構造化データモデル上でカバーしています。',
    foundation:'QTable は Web フロント、API / ドメインサービス、データ基盤を 1 つのセルフホスト可能な製品にまとめ、エンジニアリング境界に沿って拡張しやすくしています。', architectureAction:'アーキテクチャを見る',
    web:'モダンな Web 体験', webCopy:'複数のビュー、ダッシュボード、コラボレーション、AI', api:'API とドメインサービス', apiCopy:'リアルタイム、自動化、権限、監査、AI', data:'データとストレージ', dataCopy:'セルフホスト可能なオープン基盤',
    views:'柔軟な作業ビュー', ai:'AI 駆動のワークフロー', aiCopy:'AI は現在のユーザーに見えるデータと業務コンテキストから動作し、提案・プレビュー・適用は既存の権限境界に従います。',
    aiChecks:['データに根ざした Q&A','プロジェクトのリスクと進捗の分析','タスク分解と実行提案'], aiQuestion:'このプロジェクトの進捗を分析して', aiResponse:'プロジェクトは正常に進んでいます。進行中の高優先度タスクを優先し、変更を適用する前に権限と最新状態を再確認してください。', aiInput:'QTable AI に質問…',
  },
  ko: {
    note:'데이터가 더 나은 일을 이끌게', assistant:'AI 어시스턴트', assistantCopy:'데이터를 이해하고 일을 더 효율적으로',
    baseline:'현재 Alpha는 개인 업무, 프로젝트 실행, 자동화, 협업, 검색, 분석의 주요 작업면을 단일 구조화 데이터 모델 위에서 다룹니다.',
    foundation:'QTable은 웹 프런트, API / 도메인 서비스, 데이터 인프라를 하나의 셀프 호스팅 가능한 제품으로 묶어 엔지니어링 경계에 따라 확장하기 쉽게 합니다.', architectureAction:'아키텍처 살펴보기',
    web:'현대적인 웹 경험', webCopy:'여러 보기, 대시보드, 협업, AI', api:'API와 도메인 서비스', apiCopy:'실시간, 자동화, 권한, 감사, AI', data:'데이터와 스토리지', dataCopy:'셀프 호스팅 가능한 오픈 인프라',
    views:'유연한 작업 보기', ai:'AI 기반 워크플로', aiCopy:'AI는 현재 사용자가 볼 수 있는 데이터와 업무 컨텍스트에서 동작하며, 제안·미리보기·적용은 기존 권한 경계를 따릅니다.',
    aiChecks:['데이터 기반 질의응답','프로젝트 리스크·진행 분석','작업 분해와 실행 제안'], aiQuestion:'이 프로젝트의 진행 상황 분석', aiResponse:'프로젝트가 정상적으로 진행 중입니다. 진행 중인 높은 우선순위 작업에 집중하고 변경 적용 전에 권한과 최신 상태를 재확인하세요.', aiInput:'QTable AI에게 질문…',
  },
}[locale];
const layerLabels = {
  'zh-cn': { web: 'Web 前端实现', api: 'API 与领域服务' },
  'zh-tw': { web: 'Web 前端實作', api: 'API 與領域服務' },
  en: { web: 'Web frontend implementation', api: 'API & domain services' },
  ar: { web: 'تنفيذ واجهة الويب', api: 'واجهة API وخدمات النطاق' },
  fr: { web: "Implémentation du front web", api: 'API et services de domaine' },
  ru: { web: 'Реализация веб-интерфейса', api: 'API и доменные сервисы' },
  ja: { web: 'Web フロント実装', api: 'API とドメインサービス' },
  ko: { web: '웹 프런트 구현', api: 'API와 도메인 서비스' },
}[locale];
const focused = (value: string) => {
  if (locale === 'zh-cn') return value.replaceAll('QNote/Clipper', '来源接入').replaceAll('QTableUI', '前端实现');
  if (locale === 'zh-tw') return value.replaceAll('QNote/Clipper', '來源接入').replaceAll('QTableUI', '前端實作');
  return value.replaceAll('QNote/Clipper', 'source intake').replaceAll('QTableUI', 'frontend implementation');
};
---
<BaseLayout locale={locale} route="" title={c.metaTitle} description={c.metaDescription}>
<section class="hero hero-v4">
  <div class="shell hero-grid">
    <div class="hero-copy-block">
      <span class="eyebrow"><i class="eyebrow-dot"></i>{c.eyebrow}</span>
      <h1>{c.heroA} <span class="gradient">{c.heroB}</span></h1>
      <p class="hero-copy">{c.heroCopy}</p>
      <div class="hero-actions">
        <a class="button primary" href={href('docs/')}>{c.getStarted} <span aria-hidden="true">→</span></a>
        <a class="button secondary" href={QTABLE_GITHUB_URL}>GitHub {c.viewGithub}</a>
      </div>
      <div class="hero-meta"><span>Apache-2.0</span><span>Self-hostable</span><span>AI optional</span><span>Permission-aware</span><span>{QTABLE_VERSION}</span></div>
    </div>
    <div class="hero-visual">
      <div class="product-window" aria-label="QTable product preview">
        <div class="window-bar"><i class="window-dot"></i><i class="window-dot"></i><i class="window-dot"></i><span class="window-title">{c.window.title}</span></div>
        <div class="app-shell">
          <aside class="app-sidebar"><div class="side-item active"><i class="side-dot"></i>{c.window.home}</div><div class="side-item"><i class="side-dot"></i>{c.window.projects}</div><div class="side-item"><i class="side-dot"></i>{c.window.dashboards}</div><div class="side-item"><i class="side-dot"></i>{c.window.automations}</div><div class="side-item"><i class="side-dot"></i>{c.window.ai}</div></aside>
          <div class="app-main"><div class="app-toolbar"><strong>{c.window.launch}</strong><span>{c.window.myWork}</span></div><div class="view-tabs"><span class="active">Grid</span><span>Kanban</span><span>Gantt</span><span>Calendar</span><span>Gallery</span></div><div class="mini-table"><div class="mini-row header"><span>{c.window.task}</span><span>{c.window.status}</span><span>{c.window.owner}</span><span>{c.window.priority}</span></div>{c.window.rows.map((row,i)=><div class="mini-row"><span>{row[0]}</span><span><i class:list={['status-chip',{blue:i===1,amber:i===2}]}>{row[1]}</i></span><span><span class="avatar-stack"><i></i>{i%2===0&&<i></i>}</span></span><span>{row[2]}</span></div>)}</div></div>
        </div>
      </div>
      <div class="hero-note">{copy.note}</div>
      <aside class="ai-float-card"><div class="ai-float-icon"><Icon name="ai" size={19}/></div><strong>{copy.assistant}</strong><span>{copy.assistantCopy}</span></aside>
    </div>
  </div>
</section>
<section class="tech-ribbon"><div class="shell">{['React 19','TypeScript 7','VTable','FastAPI','GraphQL','PostgreSQL','Redis','S3-compatible','Apollo','VChart'].map((item)=><span class="tech-chip">{item}</span>)}</div></section>

<section class="capability-band">
  <div class="shell capability-layout">
    <div class="capability-intro"><span class="kicker">{c.baseline.kicker}</span><h2>{c.baseline.title}</h2><p>{copy.baseline}</p></div>
    <div class="capability-cards">{c.baseline.features.map(([icon,title,d])=><article class="capability-card"><div class="capability-icon"><Icon name={icon} size={21}/></div><h3>{title}</h3><p>{focused(d)}</p></article>)}</div>
  </div>
</section>

<section class="architecture-showcase">
  <div class="shell architecture-layout">
    <div class="architecture-copy"><span class="kicker">{c.foundation.kicker}</span><h2>{c.foundation.title}</h2><p>{copy.foundation}</p><a class="button secondary" href={href('qtable/')}>{copy.architectureAction} →</a></div>
    <div class="arch-pipeline" aria-label="QTable architecture overview">
      <article class="arch-stage"><div class="arch-stage-head"><div class="arch-stage-icon"><Icon name="dashboard" size={20}/></div><div><h3>QTable Web App</h3><p>{copy.webCopy}</p></div></div><div class="arch-stage-list"><span>React 19 + TypeScript</span><span>VTable + Apollo Client</span><span>{layerLabels.web}</span></div><div class="arch-mini-preview"><div class="arch-mini-side"></div><div class="arch-mini-main"><i></i><i></i><i></i><i></i></div></div></article>
      <div class="arch-connector">↔</div>
      <article class="arch-stage"><div class="arch-stage-head"><div class="arch-stage-icon"><Icon name="automation" size={20}/></div><div><h3>QTable API & Services</h3><p>{copy.apiCopy}</p></div></div><div class="arch-stage-list"><span>GraphQL API</span><span>REST API · WebSocket</span><span>Permission · Automation · AI</span><span>{layerLabels.api}</span></div></article>
      <div class="arch-connector">↔</div>
      <article class="arch-stage"><div class="arch-stage-head"><div class="arch-stage-icon"><Icon name="box" size={20}/></div><div><h3>{copy.data}</h3><p>{copy.dataCopy}</p></div></div><div class="arch-stage-list"><span>PostgreSQL</span><span>Redis</span><span>S3-compatible</span><span>SQLite fallback</span></div></article>
    </div>
  </div>
</section>

<section class="experience-section">
  <div class="shell experience-grid">
    <article class="experience-main">
      <div class="experience-copy"><span class="kicker">{copy.views}</span><h2>{c.productModel.title}</h2><p>{c.productModel.description}</p></div>
      <TableTour compact locale={locale}/>
    </article>
    <aside class="ai-panel">
      <span class="kicker">{copy.ai}</span><h2>{c.aiFlow.title}</h2><p>{copy.aiCopy}</p>
      <div class="ai-checks">{copy.aiChecks.map((item)=><div class="ai-check"><i>✓</i><span>{item}</span></div>)}</div>
      <div class="ai-chat"><div class="ai-chat-head"><i><Icon name="ai" size={16}/></i><strong>QTable AI</strong></div><div class="ai-question">{copy.aiQuestion}</div><div class="ai-response">{copy.aiResponse}<ul>{c.aiFlow.steps.slice(2,5).map(([title])=><li>{title}</li>)}</ul></div><div class="ai-input"><span>{copy.aiInput}</span><b>↗</b></div></div>
    </aside>
  </div>
</section>

<section class="section alt">
  <div class="shell"><div class="section-head"><span class="kicker">{c.release.kicker}</span><h2>{c.release.title}</h2><p>{c.release.description}</p></div><div class="release-grid"><article class="release-link-card"><h3>{c.release.matrixTitle}</h3><p>{c.release.matrixCopy}</p><a class="text-link" href={href('docs/project/feature-matrix/')}>{c.release.matrixLink} →</a></article><article class="release-link-card"><h3>{c.release.prodTitle}</h3><p>{c.release.prodCopy}</p><a class="text-link" href={href('docs/getting-started/production-checklist/')}>{c.release.prodLink} →</a></article></div></div>
</section>
<section class="cta"><div class="shell"><div class="cta-card"><h2>{c.cta.title}</h2><p>{c.cta.description}</p><div class="hero-actions"><a class="button primary" href={href('docs/')}>{c.cta.docs} →</a><a class="button secondary" href={QTABLE_GITHUB_URL}>{c.cta.source}</a></div></div></div></section>
</BaseLayout>
