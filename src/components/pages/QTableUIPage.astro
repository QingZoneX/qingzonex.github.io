---
import BaseLayout from '../../layouts/BaseLayout.astro'; import TableTour from '../TableTour.astro'; import { QTABLE_UI_GITHUB_URL } from '../../lib/site'; import { localePath } from '../../lib/i18n.mjs'; import { getPortalContent, type PortalLocale } from '../../lib/portal-content';
interface Props { locale: PortalLocale } const { locale } = Astro.props; const c=getPortalContent(locale).qtableui; const href=(p='')=>localePath(locale,p,import.meta.env.BASE_URL);
---
<BaseLayout locale={locale} route="qtable-ui/" title={c.metaTitle} description={c.metaDescription}>
<section class="page-hero"><div class="shell"><span class="eyebrow"><i class="eyebrow-dot"></i>{c.eyebrow}</span><h1>{c.heroA}<br/>{c.heroB}</h1><p>{c.heroCopy}</p><div class="page-actions"><a class="button primary" href={href('docs/qtable-ui/overview/')}>{c.readDocs} →</a><a class="button secondary" href={QTABLE_UI_GITHUB_URL}>{c.source}</a></div><div class="stats">{c.stats.map(([a,b])=><div class="stat"><strong>{a}</strong><span>{b}</span></div>)}</div></div></section>
<section class="section"><div class="shell"><div class="section-head"><span class="kicker">{c.surfaces.kicker}</span><h2>{c.surfaces.title}</h2><p>{c.surfaces.description}</p></div><div class="feature-grid">{c.surfaces.features.map(([icon,title,d])=><article class="feature-card"><div class="feature-icon">{icon}</div><h3>{title}</h3><p>{d}</p></article>)}</div></div></section>
<section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">{c.views.kicker}</span><h2>{c.views.title}</h2><p>{c.views.description}</p></div><TableTour compact locale={locale} /></div></section>
<section class="section"><div class="shell"><div class="section-head"><span class="kicker">{c.stack.kicker}</span><h2>{c.stack.title}</h2></div><div class="feature-grid">{c.stack.features.map(([icon,title,d])=><article class="feature-card"><div class="feature-icon">{icon}</div><h3>{title}</h3><p>{d}</p></article>)}</div></div></section>
<section class="section alt"><div class="shell"><div class="section-head"><span class="kicker">{c.runtime.kicker}</span><h2>{c.runtime.title}</h2><p>{c.runtime.description}</p></div><div class="two-col"><article class="product-card"><h3>{c.runtime.container}</h3><ul>{c.runtime.containerItems.map(x=><li>{x}</li>)}</ul></article><article class="product-card ui"><h3>{c.runtime.deployment}</h3><ul>{c.runtime.deploymentItems.map(x=><li>{x}</li>)}</ul></article></div></div></section>
<section class="section"><div class="shell"><div class="section-head"><span class="kicker">{c.invariants.kicker}</span><h2>{c.invariants.title}</h2><p>{c.invariants.description}</p></div><div class="two-col"><div class="product-card"><h3>{c.invariants.preserve}</h3><ul>{c.invariants.preserveItems.map(x=><li>{x}</li>)}</ul></div><div class="product-card ui"><h3>{c.invariants.avoid}</h3><ul>{c.invariants.avoidItems.map(x=><li>{x}</li>)}</ul></div></div></div></section>
<section class="cta"><div class="shell"><div class="cta-card"><h2>{c.cta.title}</h2><p>{c.cta.description}</p><div class="hero-actions"><a class="button primary" href={href('docs/qtable-ui/development/')}>{c.cta.dev} →</a><a class="button secondary" href={href('docs/project/feature-matrix/')}>{c.cta.matrix}</a><a class="button ghost" href={QTABLE_UI_GITHUB_URL}>{c.cta.source}</a></div></div></div></section>
</BaseLayout>
