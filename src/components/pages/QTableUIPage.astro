---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePath } from '../../lib/i18n.mjs';
import { getPortalContent, type PortalLocale } from '../../lib/portal-content';
interface Props { locale: PortalLocale }
const { locale }=Astro.props; const c=getPortalContent(locale).qtable; const target=localePath(locale,'qtable/',import.meta.env.BASE_URL)+'#frontend';
const redirectScript=`location.replace(${JSON.stringify(target)} + location.search + location.hash);`;
---
<BaseLayout locale={locale} route="qtable-ui/" title={c.redirect.title} description={c.redirect.description} noIndex>
<script is:inline set:html={redirectScript}></script>
<section class="redirect-page"><div class="shell"><article class="redirect-card"><span class="eyebrow"><i class="eyebrow-dot"></i>QTable</span><h1>{c.redirect.title}</h1><p>{c.redirect.description}</p><a class="button primary" href={target}>{c.redirect.action} →</a></article></div></section>
</BaseLayout>
