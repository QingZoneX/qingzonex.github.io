---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePath } from '../../lib/i18n.mjs';
import type { PortalLocale } from '../../lib/portal-content';
interface Props { locale: PortalLocale }
const { locale }=Astro.props;
const target=localePath(locale,'qtable/',import.meta.env.BASE_URL)+'#frontend';
const redirectScript=`location.replace(${JSON.stringify(target)} + location.search + location.hash);`;
const copy = {
  'zh-cn': { title:'正在前往 QTable 前端实现', description:'该旧地址已并入 QTable 产品页，正在跳转到 Web 前端实现章节。', action:'前往 QTable' },
  'zh-tw': { title:'正在前往 QTable 前端實作', description:'此舊網址已併入 QTable 產品頁，正在跳轉到 Web 前端實作章節。', action:'前往 QTable' },
  en: { title:'Redirecting to the QTable frontend implementation', description:'This legacy URL is now part of the QTable product page and forwards to the web frontend implementation section.', action:'Open QTable' },
  ar: { title:'جارٍ الانتقال إلى تنفيذ واجهة QTable', description:'أُدمج هذا العنوان القديم في صفحة منتج QTable، ويجري الانتقال إلى قسم تنفيذ الواجهة.', action:'الانتقال إلى QTable' },
  fr: { title:"Redirection vers l'implémentation front de QTable", description:"Cette ancienne URL fait désormais partie de la page produit QTable et renvoie vers la section d'implémentation front.", action:'Ouvrir QTable' },
  ru: { title:'Переход к реализации интерфейса QTable', description:'Этот прежний адрес вошёл в страницу продукта QTable; выполняется переход к разделу реализации веб-интерфейса.', action:'Перейти к QTable' },
  ja: { title:'QTable のフロント実装へ移動しています', description:'この旧 URL は QTable 製品ページに統合され、Web フロント実装セクションへ転送されます。', action:'QTable を開く' },
  ko: { title:'QTable 프런트 구현으로 이동 중', description:'이 이전 주소는 QTable 제품 페이지에 통합되어 웹 프런트 구현 섹션으로 이동합니다.', action:'QTable 열기' },
}[locale];
---
<BaseLayout locale={locale} route="qtable-ui/" title={copy.title} description={copy.description} noIndex>
<script is:inline set:html={redirectScript}></script>
<section class="redirect-page"><div class="shell"><article class="redirect-card"><span class="eyebrow"><i class="eyebrow-dot"></i>QTable</span><h1>{copy.title}</h1><p>{copy.description}</p><a class="button primary" href={target}>{copy.action} →</a></article></div></section>
</BaseLayout>
