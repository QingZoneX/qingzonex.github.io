---
// Reuse the LocaleSwitcher dropdown styling (.locale-*) so the theme picker
// matches the language picker visually. The classes are intentionally the same.

type Theme = 'dark' | 'light' | 'auto';
const t = (Astro.locals as any).t as (key: string) => string;

const labels = {
  dark: t('themeSelect.dark'),
  light: t('themeSelect.light'),
  auto: t('themeSelect.auto'),
} as const;

const accessibleLabel = t('themeSelect.accessibleLabel');

const options: Array<{ value: Theme; label: string; sub: string; iconKey: 'moon' | 'sun' | 'auto' }> = [
  { value: 'dark', label: labels.dark, sub: 'Dark', iconKey: 'moon' },
  { value: 'light', label: labels.light, sub: 'Light', iconKey: 'sun' },
  { value: 'auto', label: labels.auto, sub: 'Auto', iconKey: 'auto' },
];

// Currently active theme is decided at runtime in the script below; render the trigger with the
// neutral "theme" label so SSR markup is stable.
const triggerLabel = t('themeSelect.accessibleLabel');
---
<div class="locale-switcher compact" data-theme-switcher data-theme-options={JSON.stringify(labels)}>
  <button
    class="locale-trigger"
    type="button"
    aria-label={accessibleLabel}
    aria-haspopup="menu"
    aria-expanded="false"
    data-theme-trigger
  >
    <svg class="locale-theme-icon" viewBox="0 0 24 24" aria-hidden="true" data-theme-trigger-icon>
      <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a8.5 8.5 0 0 0 10.5 10.5z"/>
    </svg>
    <span class="locale-trigger-label" data-theme-trigger-label>{triggerLabel}</span>
    <svg class="locale-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
  </button>

  <div class="locale-menu" role="menu" aria-label={accessibleLabel} data-theme-menu hidden>
    <div class="locale-menu-title" aria-hidden="true">{accessibleLabel}</div>
    {options.map((option) => (
      <button
        class:list={['locale-option', { active: option.value === 'auto' }]}
        type="button"
        role="menuitemradio"
        aria-checked={String(option.value === 'auto')}
        data-theme-option
        data-theme-value={option.value}
      >
        <span class="locale-badge" aria-hidden="true">
          {option.iconKey === 'moon' && (
            <svg viewBox="0 0 24 24"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a8.5 8.5 0 0 0 10.5 10.5z"/></svg>
          )}
          {option.iconKey === 'sun' && (
            <svg viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="4"/>
              <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/>
            </svg>
          )}
          {option.iconKey === 'auto' && (
            <svg viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="8.5"/>
              <path d="M12 3.5v17M3.5 12h17"/>
            </svg>
          )}
        </span>
        <span class="locale-option-copy">
          <strong>{option.label}</strong>
          <small>{option.sub}</small>
        </span>
        <svg class="locale-check" viewBox="0 0 16 16" aria-hidden="true"><path d="m3.5 8.2 2.6 2.6 6.4-6.4" /></svg>
      </button>
    ))}
  </div>
</div>

<script>
  type Theme = 'dark' | 'light' | 'auto';
  const storageKey = 'starlight-theme';
  const isTheme = (v: unknown): v is Theme => v === 'dark' || v === 'light' || v === 'auto';

  const loadTheme = (): Theme => {
    try {
      const stored = localStorage.getItem(storageKey);
      if (stored === 'dark' || stored === 'light') return stored;
    } catch {}
    return 'auto';
  };

  const getSystemTheme = (): 'dark' | 'light' =>
    matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

  const storeTheme = (theme: Theme) => {
    try {
      localStorage.setItem(storageKey, theme === 'auto' ? '' : theme);
    } catch {}
  };

  const applyTheme = (theme: Theme) => {
    document.documentElement.dataset.theme = theme === 'auto' ? getSystemTheme() : theme;
  };

  // Trigger icon per resolved theme.
  const triggerIcons: Record<'dark' | 'light' | 'auto', string> = {
    dark: '<path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a8.5 8.5 0 0 0 10.5 10.5z"/>',
    light:
      '<circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/>',
    auto: '<circle cx="12" cy="12" r="8.5"/><path d="M12 3.5v17M3.5 12h17"/>',
  };

  const updateUI = (theme: Theme, root: HTMLElement) => {
    const triggerIcon = root.querySelector<SVGElement>('[data-theme-trigger-icon]');
    const triggerLabel = root.querySelector<HTMLElement>('[data-theme-trigger-label]');
    const optionsAttr = root.getAttribute('data-theme-options');
    const labels = optionsAttr ? (JSON.parse(optionsAttr) as Record<Theme, string>) : null;
    if (triggerIcon) triggerIcon.innerHTML = triggerIcons[theme];
    if (triggerLabel && labels) triggerLabel.textContent = labels[theme];
    for (const opt of root.querySelectorAll<HTMLElement>('[data-theme-option]')) {
      const value = opt.getAttribute('data-theme-value') as Theme | null;
      if (!isTheme(value)) continue;
      const isActive = value === theme;
      opt.classList.toggle('active', isActive);
      opt.setAttribute('aria-checked', String(isActive));
    }
  };

  const switchers = [...document.querySelectorAll<HTMLElement>('[data-theme-switcher]')];

  const closeAll = (except?: HTMLElement) => {
    for (const s of switchers) if (s !== except) close(s);
  };

  const close = (root: HTMLElement) => {
    const trigger = root.querySelector<HTMLButtonElement>('[data-theme-trigger]');
    const menu = root.querySelector<HTMLElement>('[data-theme-menu]');
    if (trigger) trigger.setAttribute('aria-expanded', 'false');
    if (menu) menu.hidden = true;
  };

  const open = (root: HTMLElement, focusOption = false) => {
    if (!root) return;
    closeAll(root);
    const trigger = root.querySelector<HTMLButtonElement>('[data-theme-trigger]');
    const menu = root.querySelector<HTMLElement>('[data-theme-menu]');
    if (!trigger || !menu) return;
    trigger.setAttribute('aria-expanded', 'true');
    menu.hidden = false;
    if (focusOption) {
      const active = menu.querySelector<HTMLElement>('.locale-option.active') ?? menu.querySelector<HTMLElement>('.locale-option');
      active?.focus();
    }
  };

  // Initial paint and event wiring per switcher instance.
  const current = loadTheme();
  for (const root of switchers) {
    updateUI(current, root);
    const trigger = root.querySelector<HTMLButtonElement>('[data-theme-trigger]');
    const menu = root.querySelector<HTMLElement>('[data-theme-menu]');
    if (!trigger || !menu) continue;

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      if (expanded) close(root);
      else open(root);
    });

    trigger.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        open(root, true);
      }
    });

    menu.addEventListener('click', (e) => {
      const opt = (e.target as Element | null)?.closest<HTMLElement>('[data-theme-option]');
      if (!opt) return;
      const value = opt.getAttribute('data-theme-value');
      if (!isTheme(value)) return;
      applyTheme(value);
      storeTheme(value);
      updateUI(value, root);
      close(root);
      trigger.focus();
    });

    menu.addEventListener('keydown', (e) => {
      const items = [...menu.querySelectorAll<HTMLElement>('[data-theme-option]')];
      if (!items.length) return;
      const idx = items.indexOf(document.activeElement as HTMLElement);
      if (e.key === 'Escape') {
        e.preventDefault();
        close(root);
        trigger.focus();
      } else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        const delta = e.key === 'ArrowDown' ? 1 : -1;
        const next = idx < 0 ? 0 : (idx + delta + items.length) % items.length;
        items[next]?.focus();
      } else if (e.key === 'Home' || e.key === 'End') {
        e.preventDefault();
        items[e.key === 'Home' ? 0 : items.length - 1]?.focus();
      }
    });
  }

  document.addEventListener('click', (e) => {
    for (const root of switchers) {
      if (!root.contains(e.target as Node)) close(root);
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });

  // React to system theme changes when user picked "auto".
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (loadTheme() === 'auto') applyTheme('auto');
  });
</script>